<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet">
<environment include="Development">
  <!-- Fonts & Flag icons -->
  <link rel="stylesheet" href="~/vendor/fonts/remixicon/remixicon.css" />
  <link rel="stylesheet" href="~/vendor/fonts/flag-icons.css" />
  <link rel="stylesheet" href="~/vendor/libs/node-waves/node-waves.css" />

  <!-- Core CSS -->
  <link rel="stylesheet" href="~/vendor/css/core.css" class="template-customizer-core-css" />
  <link rel="stylesheet" href="~/vendor/css/theme-default.css" class="template-customizer-theme-css" />
  <link rel="stylesheet" href="~/css/demo.css" />

  <!-- `perfect-scrollbar` library required by SideNav plugin, `typeahead` required by search -->
  <link rel="stylesheet" href="~/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" />
  <link rel="stylesheet" href="~/vendor/libs/typeahead-js/typeahead.css" />

    <!-- Application stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/marcas.css">

    <!-- Kit padrão admin (grids/forms) — antes repetido em quase toda view via VendorStyles.
         Centralizado aqui pra não precisar mais declarar em cada página. -->
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-checkboxes-jquery/datatables.checkboxes.css" />
    <link rel="stylesheet" href="~/vendor/libs/@@form-validation/form-validation.css" />
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/vendor/libs/busy-load/app.min.css" />
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
</environment>

<environment exclude="Development">
  <!-- Fonts & Flag icons -->
  <link rel="stylesheet" href="~/vendor/fonts/remixicon/remixicon.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/fonts/flag-icons.css" asp-append-version="true" />

  <!-- Core CSS -->
  <link rel="stylesheet" href="~/vendor/css/core.css" class="template-customizer-core-css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/css/theme-default.css" class="template-customizer-theme-css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/demo.css" />

  <!-- `perfect-scrollbar` library required by SideNav plugin, `typeahead` required by search -->
  <link rel="stylesheet" href="~/vendor/libs/perfect-scrollbar/perfect-scrollbar.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/node-waves/node-waves.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/typeahead-js/typeahead.css" asp-append-version="true" />

  <!-- Application stylesheets -->
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/marcas.css" asp-append-version="true" />

  <!-- Kit padrão admin (grids/forms) — mesmo conjunto do bloco Development acima; antes só
       existia lá, então em produção cada view precisava redeclarar tudo manualmente. -->
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/datatables-checkboxes-jquery/datatables.checkboxes.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/@@form-validation/form-validation.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/busy-load/app.min.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" asp-append-version="true" />
</environment>

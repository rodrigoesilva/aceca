<environment include="Development">
  <script src="~/vendor/libs/jquery/jquery.js" defer></script>
  <script src="~/vendor/libs/popper/popper.js" defer></script>
  <script src="~/vendor/js/bootstrap.js" defer></script>
  <!-- `perfect-scrollbar` library required by SideNav plugin -->
  <script src="~/vendor/libs/perfect-scrollbar/perfect-scrollbar.js" defer></script>
  <script src="~/vendor/libs/node-waves/node-waves.js" defer></script>
  <!-- `hammer` required for swipe guesture -->
  <script src="~/vendor/libs/hammer/hammer.js" defer></script>
  <!-- `i18n` required for translation -->
  <script src="~/vendor/libs/i18n/i18n.js" defer></script>
  <!-- `typeahead` required for search fn -->
  <script src="~/vendor/libs/typeahead-js/typeahead.js" defer></script>
  <!-- `typeahead` required for sideNav -->
  <script src="~/vendor/js/menu.js" defer></script>

  <!--General -->
<script src="~/vendor/libs/sweetalert2/sweetalert2.js" defer></script>
<script src="~/vendor/libs/busy-load/app.min.js" defer></script>

<script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js" defer></script>
<!-- Moment -->
<script src="~/vendor/libs/moment/moment.js" defer></script>
<!-- DatePicker -->
<script src="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.js" defer></script>
<script src="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker-globalize.js" defer></script>
<script src="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.pt-BR.min.js" defer></script>
<script src="~/vendor/libs/flatpickr/flatpickr.js" defer></script>
<!-- Form Validation -->
<script src="~/vendor/libs/@@form-validation/popular.js" defer></script>
<script src="~/vendor/libs/@@form-validation/bootstrap5.js" defer></script>
<script src="~/vendor/libs/@@form-validation/auto-focus.js" defer></script>
<!-- Select Dropdownlist -->
<script src="~/vendor/libs/select2/select2.js" defer></script>
<script src="~/vendor/libs/bootstrap-select/bootstrap-select.js" defer></script>
<script src="~/js/site.js" asp-append-version="true" defer></script>

</environment>
<environment exclude="Development">
  <script src="~/vendor/libs/jquery/jquery.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/popper/popper.js" asp-append-version="true" defer></script>
  <script src="~/vendor/js/bootstrap.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/perfect-scrollbar/perfect-scrollbar.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/node-waves/node-waves.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/hammer/hammer.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/i18n/i18n.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/typeahead-js/typeahead.js" asp-append-version="true" defer></script>
  <script src="~/vendor/js/menu.js" asp-append-version="true" defer></script>

  <!-- Kit padrão admin (grids/forms) — mesmo conjunto do bloco Development acima; antes só
       existia lá, então em produção cada view precisava redeclarar tudo manualmente. -->
  <script src="~/vendor/libs/sweetalert2/sweetalert2.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/busy-load/app.min.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/moment/moment.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker-globalize.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/bootstrap-datepicker/bootstrap-datepicker.pt-BR.min.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/flatpickr/flatpickr.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/@@form-validation/popular.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/@@form-validation/bootstrap5.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/@@form-validation/auto-focus.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/select2/select2.js" asp-append-version="true" defer></script>
  <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js" asp-append-version="true" defer></script>

  <script src="~/js/site.js" asp-append-version="true" defer></script>
</environment>

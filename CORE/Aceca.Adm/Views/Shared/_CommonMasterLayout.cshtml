@{
  @* using this variables to load front pages assets *@
  bool isFront = ViewData["isFront"] is bool isFrontValue ? isFrontValue : false;
  ViewData["main"] = isFront ? "front-" : "";
  ViewData["frontVar"] = isFront ? "Front" : "";
  @* Compact/Fluid class *@
    ViewData["contentType"] = ViewData["container"] is string container && container == "container-xxl" ? "layout-wide" : "layout-wide";

    // Botão Exportar dos grids DataTables: só o perfil Administracao vê em qualquer tela;
    // demais perfis (Fundador/MembroHonra/Socio) só o veem na tela de SocioColecao
    // (Controllers/Pages/SocioColecaoController, aberto a todos os quatro perfis). Vira
    // classe no body (ViewData, pois é usada em outra seção da página) e é lida via CSS (dt-export-btn).
    string bodyControllerName = ViewContext.RouteData.Values["controller"] as string ?? "";
    bool bCanExport = ViewContext.HttpContext.User?.IsInRole("Administracao") == true
        || bodyControllerName.Equals("SocioColecao", StringComparison.OrdinalIgnoreCase);
    ViewData["bodyExportClass"] = bCanExport ? "" : "no-export";
}

@inject IHttpContextAccessor httpContextAccessor

<!DOCTYPE html>
<html lang="en"
  class='light-style @(ViewData["navbarType"] is string navbarType ? navbarType : "") @(ViewData["menuFixed"] is string menuFixed ? menuFixed : "") @(ViewData["menuCollapsed"] is string menuCollapsed ? menuCollapsed : "") @(ViewData["contentType"] is string contentType ? contentType : "") @(ViewData["footerFixed"] is string footerFixed ? footerFixed : "") @(ViewData["customizerHidden"] is string customizerHidden ? customizerHidden : "")'
  dir="ltr" data-theme="theme-default" data-assets-path='@((httpContextAccessor.HttpContext?.Request.PathBase ?? "") + "/")'
  data-template='@(isFront ? "front-page" : (Convert.ToBoolean(TempData.Peek("menuHorizontal")?.ToString()) ? "horizontal-menu-template" : "vertical-menu-template"))'>

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  @{
        @* Título: cada view pode sobrescrever setando ViewData["Title"]; sem isso, cai no
           padrão "ACECA | {Controller}" — sem precisar repetir esse bloco em toda view. *@
        string customTitle = ViewData["title"] as string ?? "";
        string controllerName = ViewContext.RouteData.Values["controller"] as string ?? "";
        string title = !string.IsNullOrWhiteSpace(customTitle) ? customTitle : $"ACECA | {controllerName}";
        string productPage = TempData.Peek("productPage") as string ?? "";
    }
  <title>@title — Associação dos Colecionadores de Embalagens de Cigarros e Afins</title>
  <meta name="description" content="— Associação dos Colecionadores de Embalagens de Cigarros e Afins" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache"> <!-- For HTTP/1.0 compatibility -->
  <meta http-equiv="Expires" content="0"> <!-- Immediate expiration -->

  <!-- Canonical SEO -->
  <link rel="canonical" href='@productPage'>
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="~/img/favicon/favicon.ico" />

  <!-- Core Styles -->
  @await Html.PartialAsync("Sections/_Styles" + ViewData["frontVar"])


  <!-- Vendor Styles -->
  @RenderSection("VendorStyles", required: false)

  <!-- Page Styles -->
  @RenderSection("PageStyles", required: false)

  <!-- Include Scripts for customizer, helper, analytics, config -->
  @await Html.PartialAsync("Sections/_ScriptsIncludes" + ViewData["frontVar"])
</head>

<body class="@ViewData["bodyExportClass"]">
  @* Token CSRF único por página, lido pelo helper-ui-common.js e enviado como header
     (X-CSRF-TOKEN) em toda chamada AJAX - ver [ValidateAntiForgeryToken] nos
     controllers de escrita. *@
  @Html.AntiForgeryToken()

  <!-- Layout Content -->
  @RenderBody()
  <!--/ Layout Content -->

  <!-- Core Scripts -->
  @await Html.PartialAsync("Sections/_Scripts" + ViewData["frontVar"])

  <!-- Vendor Scripts -->
  @RenderSection("VendorScripts", required: false)

  <script src='~/js/@ViewData["main"]main.js' defer></script>

  @* Globais compartilhados por admin/negociação/auth: swalWithBootstrapButtons, borderColor/
     bodyBg/headingColor, busyLoadSetup e o datepicker padrão. Depende de main.js (isDarkStyle/
     config/isRtl) já carregado acima; carrega antes de PageScripts para as páginas poderem
     usar esses globais sem declará-los de novo. Não roda em páginas front (main.js diferente). *@
  @if (!isFront)
  {
    <script>
      // Flag global de perfil, pra telas/botões restritos ao Administracao (ex.: Importar
      // Coleção) poderem se esconder/bloquear no JS sem precisar reconsultar o servidor.
      // A checagem que realmente protege é sempre a do backend ([Authorize] na action).
      window.gIsAdministracao = @Json.Serialize(httpContextAccessor.HttpContext?.User?.IsInRole("Administracao") == true);
    </script>
    <script src="~/js/helper-ui-common.js" asp-append-version="true" defer></script>
  }

  @* Monitor de expiração de sessão (2h ocioso / 24h absoluto) — apenas para usuários autenticados *@
  @if (httpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true)
  {
    var absExpiry = httpContextAccessor.HttpContext.User.FindFirst("sess_abs_exp")?.Value;
    <script>
      window.__aceca_session = {
        absoluteExpiry: '@absExpiry', // ISO 8601 — teto de 24h definido no login
        idleMinutes: 120              // 2h sem uso
      };
    </script>
    <script src="~/js/session-guard.js" asp-append-version="true" defer></script>
  }

  <!-- Page Scripts-->
  @RenderSection("PageScripts", required: false)

</body>

</html>

@{

    // 2+ tags <link>/<script> com "~/" estático no mesmo @section quebram a resolução da
    // Tag Helper pra parte delas (bug conhecido do Razor - ver Helper/AssetUrlHelper.cs).
    var urlCleaveJs = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/cleavejs/cleave.js");
    var urlCleavePhoneJs = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/cleavejs/cleave-phone.js");
}

@section VendorStyles {
    <!-- Row Group CSS -->
    <link rel="stylesheet" href="~/vendor/libs/datatables-rowgroup-bs5/rowgroup.bootstrap5.css">
}

@section VendorScripts {
    <!-- Select Dropdownlist -->
    <script src="@urlCleaveJs" defer></script>
    <script src="@urlCleavePhoneJs" defer></script>
}

@section PageScripts {
    <script src="~/js/negociacao/negociacao-socio.js" asp-append-version="true" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js" defer></script>
}

@* ************** Content ************** *@
<div class="card">
    <div class="card-datatable table-responsive pt-0">
        <table class="datatables-basic table table-bordered" width="100%">
            <thead>
                <tr>
                    <th></th>
                    <th>id</th>
                    <th>S&oacute;cio</th>
                    <th>Contato</th>
                    <th>E-mail</th>
                    <th>Itens para Negocia&ccedil;&atilde;o</th>
                    <th>A&ccedil;&otilde;es</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
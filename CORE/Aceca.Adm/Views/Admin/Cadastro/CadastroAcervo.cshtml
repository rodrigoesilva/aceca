@using Aceca.Adm.VMModels
@using System.Security.Claims
@model VMMarca

@{
    Layout = $"~/Views/Shared/{(Convert.ToBoolean(@TempData.Peek("isPerfil")).ToString() == "True" ? "_HorizontalLayout" : "_WithoutMenuLayout")}.cshtml";

    // Ver Helper/AssetUrlHelper.cs - dentro de @section, só a 1ª tag "~/" resolve
    // corretamente, mesmo com asp-append-version - as demais ficam com "~/" literal
    // (admin-acervo-cadastro.js era a 2ª tag real aqui, atrás de forms-selects.js).
    var urlFormsSelects = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/forms-selects.js");
    var urlAdminAcervoCadastro = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/admin/cadastro/admin-acervo-cadastro.js");

    // Quem não é Administracao só pode se autocreditar como "Incluído por" - o
    // JS trava o combo cmbPop_IncluidoSocio nesse Id (ver fn_TravarIncluidoPorNaoAdmin
    // em admin-acervo-cadastro.js).
    var socioLogadoId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "0";
}

@section VendorStyles {
    <!-- Row Group CSS -->
    <link rel="stylesheet" href="~/vendor/libs/datatables-rowgroup-bs5/rowgroup.bootstrap5.css">

}

@section PageScripts {
    <script>
        let isAdministracao = @(User.IsInRole("Administracao") ? "true" : "false");
        let socioLogadoId = @socioLogadoId;
        let percentualMarcaDaguaPadrao = @ViewBag.PercentualMarcaDaguaPadrao;
    </script>

    <!-- Select Dropdownlist -->
    <script src="@urlFormsSelects" defer></script>

    <script src="@urlAdminAcervoCadastro" defer></script>
}

@* ************** Content ************** *@

<div class="row">
    <div class="col-12">
        <div class="card">
            <input type="hidden" id="hdId" name="hdId" value="0" />
            <input type="hidden" id="hdMarcaAcervoId" name="hdMarcaAcervoId" value="0" />
            <input type="hidden" id="hdMarcaFaseId" name="hdMarcaFaseId" value="0" />
            <input type="hidden" id="hdMarcaFinalidadeId" name="hdMarcaFinalidadeId" value="0" />
            <input type="hidden" id="hdMarcaFabricaId" name="hdMarcaFabricaId" value="0" />
            <input type="hidden" id="hdMarcaDimensaoId" name="hdMarcaDimensaoId" value="0" />
            <input type="hidden" id="hdMarcaTipoId" name="hdMarcaTipoId" value="0" />
            <input type="hidden" id="hdMarcaSubTipoId" name="hdMarcaSubTipoId" value="0" />
            <input type="hidden" id="hdMarcaImpressoraId" name="hdMarcaImpressoraId" value="0" />
            <input type="hidden" id="hdMarcaQualidadeImagemId" name="hdMarcaQualidadeImagemId" value="0" />
            <h5 class="card-header">Novo Item de Acervo</h5>
            
            <div class="card-body">
                <form id="formPage" class="row g-4">



                    @Html.AntiForgeryToken()
                    <!-- Dados da Marca -->
                    <div class="col-12">
                        <h6 id="h6Titulo">Dados do Item de Cadastro</h6>
                        <hr class="mt-0" />
                    </div>


                    <!-- 01 - Cabecalho -->
                    <div class="row mt-8 text-center">
                        <div class="col-md-4 div_nome">
                            <div class="form-floating form-floating-outline">
                                <input class="form-control" type="text" id="txt_Nome" name="txt_Nome" placeholder="Nome"/>
                                <label for="txt_Nome">Nome</label>
                            </div>
                        </div>

                        <div class="col-md-4 div_acervo">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaAcervo" name="cmbPop_MarcaAcervo" class="form-select select2">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaAcervo">Tipo Acervo</label>
                            </div>
                        </div>

                        <div class="col-md-4 div_fase">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaFase" name="cmbPop_MarcaFase" class="form-select select2">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaFase">Fase</label>
                            </div>
                        </div>

                    </div>

                    <!-- 02 - Cabecalho -->
                    <div class="row mt-8 text-center">
                        <!--Especifico para quando a fase é EXPORT -->
                        <div class="col-md-4 div_tem_pais_destino">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaExTemPaisDestino" name="cmbPop_MarcaExTemPaisDestino" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaExTemPaisDestino">Tem Pa&iacute;s de destino ?</label>
                            </div>
                        </div>
                        <!--Especifico para quando a fase é EXPORT -->

                        <div class="col-md-4 div_variante">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaVariante" name="cmbPop_MarcaVariante" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaVariante">&Eacute; uma variante ?</label>
                            </div>
                        </div>

                        <div class="col-md-4 div_variante_codigo">
                            <div class="form-floating form-floating-outline">
                                <input class="form-control" type="text" id="txt_CodigoVariante" name="txt_CodigoVariante" placeholder="C&oacute;digo Variante" />
                                <label for="txt_CodigoVariante">C&oacute;digo Variante</label>
                            </div>
                        </div>
                    </div>

                    <!-- 03 - Dados Variante Existente 
                    <div class="row mt-8 text-center div_original_variante">
                        <div class="col-md-12 mt-n1 text-center">
                            <label>Marca Original da Variante Informada</label>
                            <div id="div_NomePaiVariante" name="div_NomePaiVariante" contenteditable="true"></div>
                        </div>
                    </div>
                    -->

                    <div role="alert" class="alert alert-info alert-dismissible div_original_variante">
                        <h4 class="alert-heading d-flex align-items-center">
                            <span class="alert-icon rounded"><i class="icon-base ri ri-checkbox-circle-line icon-md"></i></span>Marca Original da Variante Informada
                        </h4>
                        <hr>
                        <p id="p_NomePaiVariante" name="p_NomePaiVariante" class="mb-0" style="text-align: center;font-weight: 500;font-size: 0.9375rem;" />
                    </div>

                    <div class="row mt-8 text-center div_codigo">
                        <div class="alert alert-solid-dark d-flex justify-content-center align-items-center flex-wrap row-gap-2" role="alert">
                            <span class="alert-icon rounded">
                                <i class="icon-base ri ri-information-line icon-md"></i>
                            </span>
                            <span id="spNovoCodigo"></span>
                        </div>
                        <div id="div_Codigo" class="alert alert-solid-primary" role="alert" hidden="hidden"></div>
                        <div id="div_NovoCodigo" class="alert alert-solid-primary" role="alert"></div>
                        <!--
                        <div class="col-md-12 mt-n1 text-center">
                            <input class="form-control" type="text" id="txt_Codigo" name="txt_Codigo" placeholder="C&oacute;digo ACECA"/>
                        </div>
                        -->
                    </div>

                    <div class="row mt-8 text-center div_dados">
                        <!-- 02 -->
                        <div class="col-md-3 mt-8 div_Incluido">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_IncluidoPor" name="cmbPop_IncluidoPor" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_IncluidoPor">Inclu&iacute;do por um s&oacute;cio ?</label>
                            </div>
                        </div>

                        <div class="col-md-3 mt-8 div_IncluidoSocio">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_IncluidoSocio" name="cmbPop_IncluidoSocio" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_IncluidoSocio">Inclu&iacute;do pelo S&oacute;cio</label>
                            </div>
                        </div>

                        <!--Especifico para quando incluido nao é socio -->
                        <div class="col-md-3 mt-8 div_IncluidoNaoSocio">
                            <div class="form-floating form-floating-outline">
                                <input class="form-control" type="text" id="txt_IncluidoPor" name="txt_IncluidoPor" placeholder="Inclu&iacute;do Por" />
                                <label for="txt_IncluidoPor">Inclu&iacute;do Por</label>
                            </div>
                        </div>
                        <!--Especifico para quando incluido nao é socio -->

                        <div class="col-md-3 mt-8 div_finalidade">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaFinalidade" name="cmbPop_MarcaFinalidade" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaFinalidade">Finalidade</label>
                            </div>
                        </div>
                    
                        <div class="col-md-3 mt-8 div_fabrica">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaFabrica" name="cmbPop_MarcaFabrica" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaFabrica">F&aacute;brica</label>
                            </div>
                        </div>

                        <div class="col-md-3 mt-8 div_codfabrica">
                            <div class="form-floating form-floating-outline">
                                <input class="form-control" type="text" id="txt_CodFabrica" name="txt_CodFabrica" placeholder="Código de Fábrica" />
                                <label for="txt_CodFabrica">C&oacute;digo F&aacute;brica</label>
                            </div>
                        </div>

                        <!-- 03 -->
                        <div class="col-md-3 mt-8 div_dimensao">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaDimensao" name="cmbPop_MarcaDimensao" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaDimensao">Dimens&atilde;o</label>
                            </div>
                        </div>

                        <div class="col-md-3 mt-8 div_tipo">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaTipo" name="cmbPop_MarcaTipo" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaTipo">Tipo</label>
                            </div>
                        </div>

                        <div class="col-md-3 mt-8 div_subtipo">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaSubTipo" name="cmbPop_MarcaSubTipo" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaSubTipo">Sub-Tipo</label>
                            </div>
                        </div>
                   
                        <div class="col-md-3 mt-8 div_impressora">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaImpressora" name="cmbPop_MarcaImpressora" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaImpressora">Impressora</label>
                            </div>
                        </div>

                        <!-- 05 -->

                        <div class="col-md-3 mt-8 div_qualidade">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaQualidadeImagem" name="cmbPop_MarcaQualidadeImagem" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaQualidadeImagem">Qualidade da Imagem</label>
                            </div>
                        </div>

                        <div class="col-md-6 mt-8 div_raridade">
                            <div class="form-floating form-floating-outline">
                                <select id="cmbPop_MarcaRaridade" name="cmbPop_MarcaRaridade" class="select2 form-select form-select">
                                    <option value="-1">-- Selecionar --</option>
                                </select>
                                <label for="cmbPop_MarcaRaridade">Raridade da Imagem</label>
                            </div>
                        </div>

                        <!-- 06 -->
                        <div class="col-md-6 mt-8 div_descricao">
                            <div class="form-floating form-floating-outline">
                                <textarea class="form-control h-px-75" id="txt_Descricao" name="txt_Descricao" placeholder="Descricao" rows="3"></textarea>
                                <label for="txt_Descricao">Descri&ccedil;&atilde;o</label>
                            </div>
                        </div>
                        <div class="col-md-6 mt-8 div_observacao">
                            <div class="form-floating form-floating-outline">
                                <textarea class="form-control h-px-75" id="txt_Observacao" name="txt_Observacao" placeholder="Observacao" rows="3"></textarea>
                                <label for="txt_Observacao">Observa&ccedil;&atilde;o</label>
                            </div>
                        </div>
                    
                        @if (User.IsInRole("Administracao"))
                        {
                            <div class="row mt-12 text-center div_descricaocompleta">
                                <div class="col-md-12 div_descfull">
                                    <div role="alert" class="alert alert-info mb-0">
                                        <h4 class="alert-heading d-flex align-items-center">
                                            <span class="alert-icon rounded"><i class="icon-base ri ri-file-text-line icon-md"></i></span>Descrição Completa
                                        </h4>
                                        <hr>
                                        <p id="div_DescFull" class="mb-0" style="text-align: center; font-weight: 500; font-size: 0.9375rem;"></p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Adicional Info -->
                    <div class="col-12 div_adicional">
                        <h6 class="mt-2">Adicional Info</h6>
                        <hr class="mt-0" />
                    </div>

                    <div class="row mt-8 text-center div_adicional">
                        <!-- 01 -->
                        <div class="col-md-4 mt-8 div_valor">
                            <div class="form-floating form-floating-outline">
                                <input class="form-control" type="text" name="txt_Valor" id="txt_Valor" placeholder="Valor" />
                                <label for="txt_Valor">Pre&ccedil;o</label>
                            </div>
                        </div>

                        <div class="col-md-4 mt-8 div_preco_1pi">
                            <div class="form-floating form-floating-outline">
                                <input class="form-control" type="text" name="txt_Valor1PI" id="txt_Valor1PI" placeholder="1º PI Cr$" />
                                <label for="txt_Valor1PI">1º PI Cr$:</label>
                            </div>
                        </div>

                        <div class="col-md-4 mt-8 div_preco_2pi">
                            <div class="form-floating form-floating-outline">
                                <input class="form-control" type="text" name="txt_Valor2PI" id="txt_Valor2PI" placeholder="2º PI Cr$" />
                                <label for="txt_Valor2PI">2º PI Cr$:</label>
                            </div>
                        </div>
                    </div>

                    <!-- Imagens -->
                    <div class="col-12 div_imagem">
                        <h6 class="mt-6">Imagens</h6>
                        <hr class="mt-0" />
                    </div>

                    @{ var classImagem = User.IsInRole("Administracao") ? "col-md-4" : "col-md-6"; }
                    <div class="row mt-4 text-center div_imagem">
                        <!-- 01 -->
                        <div class="@classImagem div_imagem_principal">
                            <div class="mb-4">
                                <label for="txt_ImgPrincipal" class="form-label">Imagem Principal</label>
                                <input id="txt_ImgPrincipal" type="file" class="form-control" accept="image/png, image/jpeg" onchange="fn_PreviewImage(this)">
                            </div>
                            <div class="mb-4 div_img_principal">
                                <label class="form-label d-block">Original (sem marca)</label>
                                <img id="img_ImgPrincipal" class="img-thumbnail" style="width: 160px; cursor: pointer; margin: 0 auto;" alt="ACECA" onclick="fn_ZoomImg(this)" onerror="this.onerror=null;this.src='https://www.aceca.com.br/assets/img/img_inexistente.jpg';">
                            </div>
                        </div>

                        @if (User.IsInRole("Administracao"))
                        {
                            <div class="col-md-2 div_percentual_imagem_principal">
                                <div class="mb-4">
                                    <label for="txt_PercentPrincipal" class="form-label">Opacidade da Marca D'água - Principal (%)</label>
                                    <input class="form-control" type="number" id="txt_PercentPrincipal" name="txt_PercentPrincipal" min="0" max="100" step="1" value="@ViewBag.PercentualMarcaDaguaPadrao" oninput="fn_ExecutarTesteMarcaDagua('principal')" />
                                </div>
                                <div class="mb-4 div_img_principal_marca">
                                    <label class="form-label d-block">Com marca d'água</label>
                                    <img id="img_ImgPrincipalComMarca" class="img-thumbnail" style="width: 160px; cursor: pointer; margin: 0 auto;" alt="ACECA" onclick="fn_ZoomImg(this)" onerror="this.onerror=null;this.src='https://www.aceca.com.br/assets/img/img_inexistente.jpg';">
                                </div>
                            </div>
                        }

                        <!-- 02 -->
                        <div class="@classImagem div_imagem_detalhe">
                            <div class="mb-4">
                                <label for="txt_ImgDetalhe" class="form-label">Imagem Detalhe</label>
                                <input class="form-control" type="file" id="txt_ImgDetalhe" accept="image/png, image/jpeg" onchange="fn_PreviewImage(this)">
                            </div>
                            <div class="mb-4 div_img_detalhe">
                                <label class="form-label d-block">Original (sem marca)</label>
                                <img id="img_ImgDetalhe" class="img-thumbnail" style="width: 160px; cursor: pointer; margin: 0 auto;" alt="ACECA" onclick="fn_ZoomImg(this)" onerror="this.onerror=null;this.src='https://www.aceca.com.br/assets/img/img_inexistente.jpg';">
                            </div>
                        </div>

                        @if (User.IsInRole("Administracao"))
                        {
                            <div class="col-md-2 div_percentual_imagem_detalhe">
                                <div class="mb-4">
                                    <label for="txt_PercentDetalhe" class="form-label">Opacidade da Marca D'água - Detalhe (%)</label>
                                    <input class="form-control" type="number" id="txt_PercentDetalhe" name="txt_PercentDetalhe" min="0" max="100" step="1" value="@ViewBag.PercentualMarcaDaguaPadrao" oninput="fn_ExecutarTesteMarcaDagua('detalhe')" />
                                </div>
                                <div class="mb-4 div_img_detalhe_marca">
                                    <label class="form-label d-block">Com marca d'água</label>
                                    <img id="img_ImgDetalheComMarca" class="img-thumbnail" style="width: 160px; cursor: pointer; margin: 0 auto;" alt="ACECA" onclick="fn_ZoomImg(this)" onerror="this.onerror=null;this.src='https://www.aceca.com.br/assets/img/img_inexistente.jpg';">
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Botoes -->
                    <div class="col-12 mt-8 div_botoes text-center">
                        <button id="btCancelar" type="reset" class="btn btn-outline-secondary me-4" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                        <button id="btCadastrar" type="button" class="btn btn-primary data-submit me-3">Cadastrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

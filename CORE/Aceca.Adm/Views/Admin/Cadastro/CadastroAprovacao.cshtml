@{
    var urlFormsSelects = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/forms-selects.js");
    var urlCadastroAprovacao = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/admin/cadastro/admin-cadastro-aprovacao.js");

    var urlResponsiveCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/datatables-responsive-bs5/responsive.dataTables.min.css");
    var urlResponsiveJs = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/datatables-responsive-bs5/dataTables.responsive.js");
}

@section VendorStyles {
    <link rel="stylesheet" href="@urlResponsiveCss" />
}

@section VendorScripts {
    <script src="@urlResponsiveJs" defer></script>
}

@section PageScripts {
    <script>
        // Controla se os botões de Aprovar/Negar/Voltar p/ Pendente aparecem na grid -
        // decidido no servidor (fonte da verdade é sempre o [Authorize] das actions), aqui
        // é só pra não desenhar botões que o backend recusaria de qualquer forma.
        let isAdministracao = @(User.IsInRole("Administracao") ? "true" : "false");
    </script>
    <script src="@urlFormsSelects" defer></script>
    <script src="@urlCadastroAprovacao" defer></script>
}

@* ************** Filtros ************** *@
<div class="card mb-6">
    <div class="card-widget-separator-wrapper">
        <div class="card-body card-widget-separator">
            <div class="head-label-filtro text-start">
                <h5 class="card-title mb-0 title-filtro">Filtros</h5>
            </div>

            <div class="row gy-4 gy-sm-1 pt-4 gap-4 gap-md-0">
                <div class="col-sm-6 col-lg">
                    <p class="mb-1">Fase</p>
                    <select id="cmb_MarcaFase" class="select2 form-select">
                        <option value="-1">-- Selecionar --</option>
                    </select>
                </div>

                <div class="col-sm-6 col-lg">
                    <p class="mb-1">Status</p>
                    <select id="cmb_StatusCadastro" class="select2 form-select">
                        <option value="-1">-- Selecionar --</option>
                    </select>
                </div>

                <div class="col-sm-6 col-lg">
                    <p class="mb-1">Sub-Tipo</p>
                    <select id="cmb_MarcaSubTipo" class="select2 form-select">
                        <option value="-1">-- Selecionar --</option>
                    </select>
                </div>

                <div class="col-sm-6 col-lg d-flex align-items-end justify-content-center">
                    <button type="button" class="btn btn-label-secondary waves-effect btn-filter-clear">
                        <span class="tf-icons ri-eraser-line ri-16px me-1_5"></span>Limpar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@*************** Content List Table ************** *@
<div class="card">
    <div class="card-datatable table-responsive pt-0">
        <table class="datatables-basic table table-hover display responsive" width="100%">
            <thead>
                <tr>
                    <th></th>
                    <th class="text-center">Enviado por</th>
                    <th class="text-center">Acervo</th>
                    <th class="text-center">Fase</th>
                    <th>Imagem</th>
                    <th>Detalhe</th>
                    <th class="text-nowrap text-center">C&oacute;d. ACECA</th>
                    <!-- w-25/w-50 removidas: o Responsive mede a largura mínima de cada
                         coluna clonando só o <th> num <div> de 1px de largura - width:%
                         nesse contexto resolve pra uma fração de pixel, fazendo o
                         Responsive achar que Nome/Descrição não precisam de espaço nenhum
                         no cálculo de quantas colunas cabem no mobile. -->
                    <th class="text-start">Nome</th>
                   
                    <th class="text-start">Descri&ccedil;&atilde;o</th>
                    <th class="text-center">Tipo / Sub-Tipo</th>
                    
                    <th class="text-center">Status</th>
                    <th class="text-start">Observação</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

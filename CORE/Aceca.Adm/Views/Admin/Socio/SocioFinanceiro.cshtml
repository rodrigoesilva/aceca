@{
    Layout = $"~/Views/Shared/{@TempData["Layout"]}.cshtml";

    // Ver Helper/AssetUrlHelper.cs - dentro de @section, só a 1ª tag com
    // asp-append-version é processada pelo Tag Helper; as demais ficam com "~/"
    // literal (JS não carrega).
    var urlFormsSelects = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/forms-selects.js");
    var urlAdminSocioFinanceiro = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/admin/socio/admin-socio-financeiro.js");
}

@section VendorStyles {
    <!-- Row Group CSS -->
    <link rel="stylesheet" href="~/vendor/libs/datatables-rowgroup-bs5/rowgroup.bootstrap5.css">
    <!-- Form Validation -->

    <!-- DatePicker
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker.min.css" />
     -->
    <!-- DatePicker RANGE
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-daterangepicker/3.0.5/daterangepicker.css" />
     -->
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-daterangepicker/bootstrap-daterangepicker.css" />

}

@section VendorScripts {
    <!-- Form Validation -->

    <!-- DatePicker
    <script src="~/vendor/libs/bootstrap-daterangepicker/bootstrap-daterangepicker.js" defer></script> -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js" defer></script>

    <!-- DatePicker Range
    <script src="~/vendor/libs/bootstrap-daterangepicker/bootstrap-daterangepicker.js" defer></script>
     -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-daterangepicker/3.0.5/daterangepicker.min.js" defer></script>

} 

@section PageScripts {
    <!-- Select Dropdownlist -->
    <script src="@urlFormsSelects" defer></script>

    <script src="@urlAdminSocioFinanceiro" defer></script>
}

@* ************** Content ************** *@
<div class="card">
    <div class="card-datatable table-responsive pt-0">
        <table class="datatables-basic table table-bordered" width="100%">
            <thead>
                <tr>
                    <th></th>
                    <th>id</th>
                    <th>Nome</th>
                    <th>Status S&oacute;cio</th>
                    <th>Tipo Pagamento</th>                   
                    <th>&Uacute;ltimo Pagamento</th>
                    <th>Status Pagamento</th>
                    <th>A&ccedil;&otilde;es</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Modal Add new Item -->
<div class="offcanvas offcanvas-end" id="pop-add-new-item">
    <div class="offcanvas-header border-bottom">
        <input type="hidden" id="hdId" name="hdId" value="0"/>
        <input type="hidden" id="hdSocioFinanceiroId" name="hdSocioFinanceiroId" value="0" />
        <h5 class="offcanvas-title" id="h5-pop-add-new-item">Novo Registro</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body flex-grow-1">
        <form class="form-add-new-item pt-0 row g-3" id="form-pop-add-new-item" onsubmit="return false">
            <div class="col-sm-12 div_cmb_Socio">
                <div class="form-floating form-floating-outline">
                    <select id="cmb_Socio" name="cmb_Socio" class="form-select select2">
                        <option value="-1">-- Selecionar --</option>
                    </select>
                    <label for="cmb_Socio">S&oacute;cio</label>
                </div>
            </div>
            <div class="col-sm-12 div_txt_Socio">
                <div class="input-group input-group-merge">
                    <span id="line_item_01" class="input-group-text"></span>
                    <div class="form-floating form-floating-outline">
                        <input type="text" id="pop_line_item_01" class="form-control dt-line-01" name="pop_line_item_01"
                               placeholder="Nome" aria-label="Nome" aria-describedby="line_item_01" disabled/>
                        <label for="pop_line_item_01">Nome</label>
                    </div>
                </div>
            </div>

            <div id="pop_div_line_item_02" name="TipoPagamento" class="col-sm-12">
                <div class="form-floating form-floating-outline">
                    <select id="cmb_TipoPagamento" name="cmb_TipoPagamento"
                            class="form-select select2 dt-line-02"
                            data-allow-clear="true">
                        <option value="-1">-- Selecionar --</option>
                    </select>
                    <label for="cmb_TipoPagamento">Tipo Pagamento</label>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" id="pop_line_item_03" class="form-check-input dt-line-03"
                               name="pop_line_item_03" placeholder="StatusPagamento" aria-label="StatusPagamento"
                               aria-describedby="line_item_03"/>
                        <label class="form-check-label" for="pop_line_item_03">Em Dia</label>
                    </div>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <span id="line_item_04" class="input-group-text"></span>
                    <div class="form-floating form-floating-outline">
                        <input type="text" id="pop_line_item_04" class="form-control dt-calendar dt-line-04"
                               name="pop_line_item_04" placeholder="DD/MM/YYYY" aria-label="UltimoPagamento"
                               aria-describedby="line_item_04" />
                        <label for="pop_line_item_04">&Uacute;ltimo Pagamento</label>
                    </div>
                </div>
            </div>
            <!--
            <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" id="pop_line_item_05" class="form-check-input dt-line-05"
                               name="pop_line_item_05" placeholder="Ativo" aria-label="Ativo"
                               aria-describedby="line_item_05"/>
                        <label class="form-check-label" for="pop_line_item_05">Ativo</label>
                    </div>
                </div>
            </div>
            -->
            <div class="col-sm-12">
                <button type="submit" class="btn btn-primary data-submit me-sm-4 me-1">Adicionar</button>
                <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancelar</button>
            </div>
        </form>

    </div>
</div>
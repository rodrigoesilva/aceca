@model Aceca.Adm.Models.Marcas

@{
    Layout = $"~/Views/Shared/{@TempData["Layout"]}.cshtml";

    // Ver Helper/AssetUrlHelper.cs - dentro de @section, só a 1ª tag com
    // asp-append-version é processada pelo Tag Helper; as demais ficam com "~/"
    // literal (JS não carrega).
    var urlAdminSocioColecao = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/admin/socio/admin-socio-colecao.js");
    var urlModalMarca = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/modal/modal-marca.js");
    var urlFormsSelects = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/forms-selects.js");
}

@section VendorStyles {
    <!-- Row Group CSS -->
    <link rel="stylesheet" href="~/vendor/libs/datatables-rowgroup-bs5/rowgroup.bootstrap5.css">

    <!-- CSS PAGE -->
    <link rel="stylesheet" href="~/css/zoom.css" asp-append-version="true">

    <!--  <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.8/css/responsive.dataTables.min.css">-->
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.dataTables.min.css" />
}

@section VendorScripts {

    <!--<script src="https://cdn.datatables.net/responsive/2.1.0/js/dataTables.responsive.js" defer></script>-->
    <script src="~/vendor/libs/datatables-responsive-bs5/dataTables.responsive.js" defer></script>
} 

@section PageScripts {
    <script src="@urlAdminSocioColecao" defer></script>
    <script src="@urlModalMarca" defer></script>

    <!-- Select Dropdownlist -->
    <script src="@urlFormsSelects" defer></script>
}

@* ************** Filtros ************** *@
<div class="card mb-6">
    <div class="card-widget-separator-wrapper">
        <div class="card-body card-widget-separator">
            <div class="head-label-filtro text-start">
                <h5 class="card-title mb-0 title-filtro">Filtros</h5>
            </div>
            <div>
                @Html.Hidden("hdMarcaAcervoId", Model?.MarcaAcervoId)
                @Html.Hidden("hdMarcaAcervoNome", "")
            </div>

            <!-- LINHA 01 -->
            <div class="row gy-4 gy-sm-1 pt-4 gap-4 gap-md-0">

                <!-- Status Colecao  -->
                <div class="col-sm-6 col-lg-3">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 row gap-4 gap-md-0">
                        <div>
                            <p class="mb-1">* Status</p>
                            <select id="cmb_ColecaoStatus" class="select2 form-select form-select">
                                <option value="-1">-- Todos --</option>
                            </select>
                        </div>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none me-6">
                </div>
               
                <!-- Fase -->
                <div class="col-sm-6 col-lg-3">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 row gap-4 gap-md-0">
                        <div>
                            <p class="mb-1">* Fase</p>
                            <select id="cmb_MarcaFase" class="select2 form-select form-select">
                                <option value="-1">-- Selecionar --</option>
                            </select>
                        </div>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none me-6">
                </div>

                <!-- Tipo-->
                <div class="div_MarcaTipo col-sm-6 col-lg-3">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 row gap-4 gap-md-0">
                        <div>
                            <p class="mb-1">* Tipo</p>
                            <select id="cmb_MarcaTipo" class="select2 form-select form-select">
                                <option value="-1">-- Selecionar --</option>
                            </select>
                        </div>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none me-6">
                </div>

                <!-- Sub-Tipo -->
                <div class="div_MarcaSubTipo col-sm-6 col-lg-3">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 row gap-4 gap-md-0">
                        <div>
                            <p class="mb-1">* Sub-Tipo</p>
                            <select id="cmb_MarcaSubTipo" class="select2 form-select form-select">
                                <option value="-1">-- Selecionar Tipo --</option>
                            </select>
                        </div>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none me-6">
                </div>

            </div>

            <!-- LINHA 02 -->
            <div class="row gy-4 gy-sm-1 pt-4 gap-4 gap-md-0">
                
                <!-- Flag Listar Sem Variacao -->
                <div class="div_PesquisarSemVariante d-flex justify-content-center col-sm-6 col-lg-4">
                    <div class="d-flex justify-content-between align-items-end card-widget-1 row gap-4 gap-md-0">
                        <div>
                            <div class="pt-8">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox"
                                           id="chk_PesquisarSemVariante">
                                    <label class="form-check-label" for="chk_PesquisarSemVariante">Listar sem Variantes</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none me-6">
                </div>

                <!-- Flag Pesquisar na Descricao -->
                <div class="div_PesquisarDescricao d-flex justify-content-center col-sm-6 col-lg-4">
                    <div class="d-flex justify-content-between align-items-end card-widget-1 row gap-4 gap-md-0">
                        <div>
                            <div class="pt-8">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox"
                                    id="chk_PesquisarDescricao">
                                    <label class="form-check-label" for="chk_PesquisarDescricao">Pesquisar na Descrição</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none me-6">
                </div>

                <!-- Botoes -->
                <div class="div_Botoes col-sm-6 col-lg-4">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 row gap-4 gap-md-0">
                        <div class="d-flex justify-content-center align-content-center flex-wrap gap-4 pt-8">                            
                            <button type="button" class="btn btn-label-secondary waves-effect btn-filter-clear">
                                <span class="tf-icons ri-eraser-line ri-16px me-1_5"></span>Limpar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*************** Content List Table ************** *@
<div class="card">
    <div class="card-datatable table-responsive pt-0">
        <table class="datatables-basic table table-hover display responsive" width="100%">
            <thead>
                <tr>
                    <th></th>
                    <th class="text-center"><input type="checkbox" id="chkColecaoSelectAll" class="form-check-input"></th>
                    <th class="text-nowrap text-center">C&oacute;d. ACECA</th>
                    <th class="text-start w-25">Nome</th>
                    <th>Imagem</th>
                    <th>Detalhe</th>
                    <th class="text-start w-50">Descri&ccedil;&atilde;o</th>
                    <th>F&aacute;brica</th>
                    <th>Sub-Tipo</th>
                    <th>Fase</th>
                    <th class="text-nowrap text-center">Observa&ccedil;&atilde;o</th>
                    <th class="text-nowrap text-center" style="text-align:center!important">Inclu&iacute;do por</th>
                    <th>Inclu&iacute;do por</th>
                    <th></th>@*<th>A&ccedil;&otilde;es</th> *@
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- The Modal Zoom -->
<div id="myModal" class="img-zoom-modal">
    <span id="caption">img</span>
    <img class="img-zoom-content" id="img01">
</div>

<!-- Modal Add new Item -->
<div class="offcanvas offcanvas-end" id="pop-add-new-item">
    <div class="offcanvas-header border-bottom">
        <input type="hidden" id="hdId" name="hdId" value="0" />
        <input type="hidden" id="hdIdMarca" name="hdIdMarca" value="0" />
        <h5 class="offcanvas-title" id="h5-pop-add-new-item">Novo Registro</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body flex-grow-1">
        <form class="form-add-new-item pt-0 row g-3" id="form-pop-add-new-item" onsubmit="return false">
            <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <span id="line_item_01" class="input-group-text"></span>
                    <div class="form-floating form-floating-outline">
                        <input type="text" id="pop_line_item_01" class="form-control dt-line-01" name="pop_line_item_01"
                               placeholder="observacao" aria-label="Observacao" aria-describedby="line_item_01" />
                        <label for="pop_line_item_01">Observa&ccedil;&atilde;o</label>
                    </div>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" id="pop_line_item_05" class="form-check-input dt-line-05"
                               name="pop_line_item_05" placeholder="Negociacao" aria-label="Negociacao"
                               aria-describedby="line_item_03" />
                        <label class="form-check-label" for="pop_line_item_05">Para Negocia&ccedil;&atilde;o</label>
                    </div>
                </div>
            </div>
            <div class="col-sm-12">
                <button id="btn-submit-modal" type="submit" class="btn btn-primary data-submit me-sm-4 me-1">Adicionar</button>
                <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancelar</button>
            </div>
        </form>

    </div>
</div>

<!-- Modal Lateral - Form de Importacao de Colecao XLS -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="modalUploadXls" aria-labelledby="modalUploadXlsLabel">
    <!-- Offcanvas Header -->
    <div class="offcanvas-header py-6">
        <h5 id="modalUploadXlsLabel" class="offcanvas-title">Planilha de Coleção</h5>
    </div>

    <!-- Offcanvas Body -->
    <div class="offcanvas-body border-top">
        <!-- Title -->
        <div class="form-floating form-floating-outline mb-5">
            <a href="~/file/ACECA_ModeloPlanilhaColecao.xlsx"
               download="~/file/ACECA_ModeloPlanilhaColecao.xlsx"
               class="waves-effect btn-modelo"
               role="button">
                <div class="alert d-flex align-items-center alert-primary h5" role="alert">
                        <span class="alert-icon me-4 rounded-2" data-bs-toggle="tooltip" 
                            data-bs-placement="top" title="Download Planilha Modelo">
                              <i class="ri-download-cloud-line ri-22px"></i>
                        </span>
                    Faça aqui o download da planilha modelo de coleção
                </div>
            </a>

            <div class="alert d-flex align-items-center alert-info mb-0 h5" role="alert">
                <span class="alert-icon me-4 rounded-2"><i class="ri-information-line ri-22px"></i></span>
                Selecione a planilha com os dados da sua Coleção
            </div>
        </div>

        <!-- Upload Input -->
        <div class="mb-5">
            <input id="fileUpload" name="fileUpload" class="form-control" type="file" accept=".xlsx, .xls">
        </div>

        <!-- Botoes -->
        <div class="mb-5">
            <button id="btnColecao_DadosCarregar" type="submit" class="btn btn-primary me-sm-3 me-1 data-submit">
                <span class="tf-icons ri-upload-2-fill ri-16px me-1_5"></span>Carregar
            </button>
            <button id="btnColecao_DadosCancelar" type="reset" class="btn btn-label-secondary waves-effect btn-cancel" data-bs-dismiss="offcanvas">
                Cancelar
            </button>
        </div>

        <!-- Progress -->
        <div id="divprogressbar" class="demo-vertical-spacing" style="display: none;">
            <div class="progress" style="font-size: large; height: 40px;">
                <div id="divprogressbar_upload" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
            </div>
        </div>
    </div>
</div>


@{
    Layout = $"~/Views/Shared/{@TempData["Layout"]}.cshtml";
}

@section VendorStyles {
    <!-- Row Group CSS -->
    <link rel="stylesheet" href="~/vendor/libs/datatables-rowgroup-bs5/rowgroup.bootstrap5.css">

}

@section PageStyles {
    <style>
        /* Mobile: a coluna de controle (só o ícone de expandir) precisa de largura
           mínima garantida - sem isso, com Imagem+Descrição ocupando quase todo o
           card, o ícone fica espremido/cortado (mesmo tratamento de Agenda/etc.). */
        #tblAgendaImagem thead th:first-child,
        #tblAgendaImagem tbody td.control {
            padding-left: 0.25rem !important;
            padding-right: 0 !important;
            min-width: 28px !important;
            width: 28px !important;
        }
        /* O fix do checkbox "Exibir Somente Ativos" colidindo com Pesquisar virou
           regra global em site.css (.dataTables_wrapper ...), pois o mesmo padrão
           se repete em todas as telas de grid admin. */
    </style>
}

@section PageScripts {
    <script src="~/js/admin/agenda/admin-agenda-imagem.js" asp-append-version="true" defer></script>
}

@* ************** Content ************** *@
<div class="card">
    <div class="card-datatable table-responsive pt-0">
        <table id="tblAgendaImagem" class="datatables-basic table table-bordered" width="100%">
            <thead>
            <tr>
                <th></th>
                <th>id</th>
                <th>Imagem</th>
                <th>Descri&ccedil;&atilde;o</th>
                <th>Status</th>
                <th>A&ccedil;&otilde;es</th>
            </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Modal Add new Item -->
<div class="offcanvas offcanvas-end offcanvas-w-25" id="pop-add-new-item">
    <div class="offcanvas-header border-bottom">
        <input type="hidden" id="hdId" name="hdId" value="0"/>
        <h5 class="offcanvas-title" id="h5-pop-add-new-item">Novo Registro</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body flex-grow-1">
        <form class="form-add-new-item pt-0 row g-3" id="form-pop-add-new-item" onsubmit="return false">
            <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <span id="line_item_01" class="input-group-text"></span>
                    <div class="form-floating form-floating-outline">
                        <input type="file" id="pop_line_item_01" class="form-control dt-line-01" name="pop_line_item_01"
                               placeholder="descricao" aria-label="Descricao" aria-describedby="line_item_01" />
                        <label for="pop_line_item_01">Imagem</label>
                    </div>
                </div>
            </div>
            
             <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <span id="line_item_02" class="input-group-text"></span>
                    <div class="form-floating form-floating-outline">
                        <input type="text" id="pop_line_item_02" class="form-control dt-line-02"
                               name="pop_line_item_02" placeholder="Descri&ccedil;&atilde;o:" aria-label="Descricao"
                               aria-describedby="line_item_02" />
                        <label for="pop_line_item_02">Descri&ccedil;&atilde;o</label>
                    </div>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" id="pop_line_item_05" class="form-check-input dt-line-05"
                               name="pop_line_item_05" placeholder="Ativo" aria-label="Ativo"
                               aria-describedby="line_item_05"/>
                        <label class="form-check-label" for="pop_line_item_05">Ativo</label>
                    </div>
                </div>
            </div>
            <div class="col-sm-12">
                <button type="submit" class="btn btn-primary data-submit me-sm-4 me-1">Adicionar</button>
                <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancelar</button>
            </div>
        </form>

    </div>
</div>
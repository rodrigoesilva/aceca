@{
    var pageApp = "ACECA";
    var pageName = ViewContext?.RouteData?.Values["controller"] as string ?? "";
    var pageTipo = string.Empty;

    ViewData["Title"] = string.Format("{0} | {1} | {2}", pageApp, pageName, pageTipo);

    Layout = $"~/Views/Shared/_BlankLayout.cshtml";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.css" />

    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/vendor/libs/busy-load/app.min.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/&#64;form-validation/popular.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/bootstrap5.js"></script>
    <script src="~/vendor/libs/&#64;form-validation/auto-focus.js"></script>

    <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="~/vendor/libs/busy-load/app.min.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/css/pages/auth-login.css?v=1.0.1">
    <link rel="stylesheet" href="~/css/style.css">
}

@section PageScripts {
    <script src="~/js/auth/pages-auth.js?v=1.0.1"></script>
}

@* ************** Content ************** *@

        <div class="position-relative login-bg-img">
            <div class="authentication-wrapper authentication-basic container-p-y">
                <div class="authentication-inner py-6 mx-4">
                    <div class="pg-login">
                        <div class="login-bg">
                            <div class="" style="position: absolute;inset: 0;"></div>
                        </div>
                
                        <div class="login-wrap">
                            <div class="login-card mt-1">
                                <div class="lc-logo">
                                    <div class="lc-circle">
                                        <img src="img/logo/logo.webp" loading="lazy" decoding="async" title="ACECA" alt="ACECA">
                                    </div>
                                    <div>
                                        <span class="lc-aceca custom_text">ACECA</span>
                                        <span class="lc-area">&Aacute;rea do S&oacute;cio</span>
                                    </div>
                                </div>
                                <h2>Acesse sua conta</h2>
                                <p class="lc-sub">Entre com suas credenciais para acessar a plataforma exclusiva.</p>
                                <div id="loginErr" class="login-err" style="display:none"></div>
                        
                                <!--begin::Form-->
                                    <form id="frmLogin" class="form" action="#" autocomplete="off" novalidate>

                                        <div class="fg">
                                            <label for="lEmail">E-mail</label>
                                            <input class="form-control"
                                                   type="email"
                                                   id="lEmail"
                                                   name="lEmail"
                                                   placeholder="seu@email.com.br"
                                                   required
                                                   autocomplete="username"
                                                   inputmode="email">
                                        </div>

                                        <div class="fg pwd-fg form-password-toggle">
                                            <label for="lSenha">Senha</label>
                                            <input class="form-control"
                                                   type="password"
                                                   id="lSenha"
                                                   name="lSenha"
                                                   placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;"
                                                   required
                                                   autocomplete="current-password">
                                            <button type="button" class="eye-btn cursor-pointer" title="Mostrar/ocultar senha" aria-label="Mostrar ou ocultar senha">
                                                <i class="ri-eye-off-line ri-20px" aria-hidden="true"></i>
                                            </button>
                                        </div>

                            <!--{{!-- Link atualizado para a página interna de "Esqueci a senha" --}}-->
                                        <div class="login-opts">
                                            <a href="/Auth/ForgotPassword" class="link-senha">Esqueceu a senha?</a>
                                        </div>
                                        

                                        <!--{{!-- Botão de submit --}}-->
                                        <button type="submit" class="btn-entrar" id="btnEntrar">
                                            <span class="btn-text">Entrar</span>
                                            <span class="btn-spinner" style="display:none;" aria-hidden="true">
                                                <i class="ri-loader-4-line ri-spin"></i> Verificando…
                                            </span>
                                        </button>

                                    </form>
                                <!--end::Form-->

                                <p class="lc-cadastro">Ainda n&atilde;o &eacute; S&oacute;cio? <a href="https://www.aceca.com.br/#contato">Solicite sua associa&ccedil;&atilde;o</a></p>
                                <a href="https://www.aceca.com.br/" class="back-site">← Voltar ao Site</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
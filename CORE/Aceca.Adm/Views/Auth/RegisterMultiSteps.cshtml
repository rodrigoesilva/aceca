@{
    Layout = $"~/Views/Shared/_BlankLayout.cshtml";
}

@{
    var urlStyleCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/css/style.css");
    var urlAuthLoginCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/css/pages/auth-login.css");
}

@section PageStyles {
    <link rel="stylesheet" href="@urlAuthLoginCss">
    <link rel="stylesheet" href="@urlStyleCss">
}

@section PageScripts {
    <script src="~/js/auth/pages-auth-multisteps.js" asp-append-version="true" defer></script>
}

@* ************** Content ************** *@

        <div class="position-relative login-bg-img">
            <div class="authentication-wrapper authentication-basic container-p-y">
                <div class="authentication-inner py-6 mx-4">
                    <div class="pg-login">
                        <div class="login-bg">
                            <div class="" style="position: absolute;inset: 0;"></div>
                        </div>

                        <div class="login-wrap login-wrap-wide">
                            <div class="login-card mt-1 login-card-wide">
                                <div class="lc-logo">
                                    <div class="lc-circle">
                                        <img src="~/img/logo/logo.webp" loading="lazy" decoding="async" title="ACECA" alt="ACECA">
                                    </div>
                                    <div>
                                        <span class="lc-aceca custom_text">ACECA</span>
                                        <span class="lc-area">&Aacute;rea do S&oacute;cio</span>
                                    </div>
                                </div>
                                <h2>Complete seu cadastro</h2>
                                <p class="lc-sub">Falta pouco! Preencha seus dados para ativar seu acesso de teste.</p>
                                <div id="msErr" class="login-err" style="display:none"></div>

                                <form id="frmCadastroCompleto" class="form" autocomplete="off" novalidate>
                                    <input type="hidden" id="msToken" value="@ViewBag.Token">
                                    <input type="hidden" id="msEmail" value="@ViewBag.Email">

                                    <h6 class="ms-secao">Dados pessoais</h6>
                                    <div class="row gy-4">
                                        <div class="col-sm-6">
                                            <div class="fg">
                                                <label for="msNome">Nome completo</label>
                                                <input class="form-control" type="text" id="msNome" value="@ViewBag.Nome" required autocomplete="name">
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="fg">
                                                <label for="msNascimento">Data de nascimento</label>
                                                <input class="form-control" type="text" id="msNascimento" placeholder="DD/MM/AAAA" inputmode="numeric" maxlength="10">
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="fg">
                                                <label for="msTelefone">Telefone</label>
                                                <input class="form-control" type="text" id="msTelefone" placeholder="(00) 00000-0000" inputmode="numeric" maxlength="15">
                                            </div>
                                        </div>
                                    </div>

                                    <h6 class="ms-secao">Endereço</h6>
                                    <div class="row gy-4">
                                        <div class="col-sm-3">
                                            <div class="fg">
                                                <label for="msCep">CEP</label>
                                                <input class="form-control" type="text" id="msCep" placeholder="00000-000" inputmode="numeric" maxlength="9">
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="fg">
                                                <label for="msEndereco">Endereço</label>
                                                <input class="form-control" type="text" id="msEndereco" placeholder="Rua, avenida...">
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="fg">
                                                <label for="msNumero">Número</label>
                                                <input class="form-control" type="text" id="msNumero">
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="fg">
                                                <label for="msComplemento">Complemento</label>
                                                <input class="form-control" type="text" id="msComplemento" placeholder="Apto, bloco...">
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="fg">
                                                <label for="msBairro">Bairro</label>
                                                <input class="form-control" type="text" id="msBairro">
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="fg">
                                                <label for="msCidade">Cidade</label>
                                                <input class="form-control" type="text" id="msCidade">
                                            </div>
                                        </div>
                                        <div class="col-sm-4">
                                            <div class="fg">
                                                <label for="msEstado">Estado</label>
                                                <select class="form-control" id="msEstado">
                                                    <option value="">Selecione</option>
                                                    <option>AC</option><option>AL</option><option>AP</option><option>AM</option>
                                                    <option>BA</option><option>CE</option><option>DF</option><option>ES</option>
                                                    <option>GO</option><option>MA</option><option>MT</option><option>MS</option>
                                                    <option>MG</option><option>PA</option><option>PB</option><option>PR</option>
                                                    <option>PE</option><option>PI</option><option>RJ</option><option>RN</option>
                                                    <option>RS</option><option>RO</option><option>RR</option><option>SC</option>
                                                    <option>SP</option><option>SE</option><option>TO</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn-entrar mt-6" id="btnCadastroCompleto">
                                        <span class="btn-text">Concluir cadastro</span>
                                        <span class="btn-spinner" style="display:none;" aria-hidden="true">
                                            <i class="ri-loader-4-line ri-spin"></i> Enviando…
                                        </span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

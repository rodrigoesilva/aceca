@{
    ViewData["Title"] = "Account settings - Pages";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="~/vendor/libs/&#64;form-validation/form-validation.css" />
    <link rel="stylesheet" href="~/vendor/libs/animate-css/animate.css" />
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-checkboxes-jquery/datatables.checkboxes.css">
    <style>
        /* Pix e Cartão ficam empilhados na mesma célula do grid (em vez de d-none), pra
           altura do card não pular ao trocar o rádio - o grid sempre dimensiona a célula
           pela mais alta das duas, mesmo com a outra oculta. */
        #div_formapagamento_conteudo {
            display: grid;
        }
        #div_formapagamento_conteudo > div {
            grid-area: 1 / 1;
        }
        .pagamento-oculto {
            visibility: hidden;
            pointer-events: none;
        }
    </style>
}

@section VendorScripts {
    <script src="~/vendor/libs/select2/select2.js" defer></script>
    <script src="~/vendor/libs/&#64;form-validation/popular.js" defer></script>
    <script src="~/vendor/libs/&#64;form-validation/bootstrap5.js" defer></script>
    <script src="~/vendor/libs/&#64;form-validation/auto-focus.js" defer></script>
    <script src="~/vendor/libs/cleavejs/cleave.js" defer></script>
    <script src="~/vendor/libs/cleavejs/cleave-phone.js" defer></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.js" defer></script>
    <script src="~/vendor/libs/moment/moment.js" defer></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js" defer></script>
}

@section PageScripts {
    <script src="~/js/auth/pages-auth-account-settings-financeiro.js" asp-append-version="true" defer></script>
}

@* ************** Content ************** *@
<div class="row">
    <div class="col-md-12">
        <!-- Steps -->
        <div class="nav-align-top">
            <ul class="nav nav-pills flex-column flex-md-row mb-6 gap-2 gap-lg-0">
                <li class="nav-item"><a class="nav-link" href="AccountSettings"><i class="ri-group-line me-1_5"></i> Meus Dados</a></li>
                <li class="nav-item"><a class="nav-link" href="AccountSettingsSecurity"><i class="ri-lock-line me-1_5"></i> Segurança</a></li>
                <li class="nav-item"><a class="nav-link active" href="javascript:void(0);"><i class="ri-bookmark-line me-1_5"></i> Financeiro</a></li>
            </ul>
        </div>

        <div class="row">
            <!-- Current Plan -->
            <div id="div_planoatual" class="col-12 col-md-6">
                <div class="card mb-6 h-100">
                    <h5 class="card-header">Plano Atual</h5>
                    <div class="card-body pt-1">
                        <div class="row">
                            <div class="col-md-6 mb-1">
                                <div class="mb-6">
                                    <h6 class="mb-1">Seu plano atual é o <span id="fin_TipoPagamento">-</span></h6>
                                    <p id="fin_Cadencia">-</p>
                                </div>
                                <div class="mb-6">
                                    <h6 id="fin_AtivoDesde" class="mb-1">-</h6>
                                    <p id="fin_Vencimento">-</p>
                                </div>
                                <div>
                                    <h6 class="mb-1"><span class="me-1">Situação do Pagamento</span> <span id="fin_StatusBadge" class="badge bg-label-secondary rounded-pill">-</span></h6>
                                    <p id="fin_UltimoPagamentoTexto" class="mb-1">-</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div id="fin_AlertWrapper" class="alert alert-warning mb-6 alert-dismissible" role="alert">
                                    <h5 class="alert-heading mb-1 d-flex align-items-center">
                                        <span class="alert-icon rounded"><i class="ri-alert-line ri-22px"></i></span>
                                        <span id="fin_AlertTitulo">Precisamos da sua atenção!</span>
                                    </h5>
                                    <span id="fin_AlertTexto" class="ms-11 ps-1">-</span>
                                </div>
                                <div id="fin_StatisticsWrapper" class="plan-statistics">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="mb-1">Dias</h6>
                                        <h6 id="fin_DiasLabel" class="mb-1">-</h6>
                                    </div>
                                    <div class="progress rounded mb-1" style="height: 38px;">
                                        <div id="fin_ProgressBar" class="progress-bar rounded" role="progressbar" style="width: 0%; font-size: 0.9375rem; font-weight: 500; line-height: 1.375;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <small id="fin_DiasRestantesTexto">-</small>
                                </div>
                            </div>
                            <div class="col-12 d-flex gap-2 mt-6 flex-wrap">
                                <button class="btn btn-primary me-2" data-bs-toggle="modal" data-bs-target="#pricingModal">Plano de atualização</button>
                                <button class="btn btn-outline-danger cancel-subscription">Cancelar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- /Forma pagamento -->
            <div id="div_formapagamento" class="col-12 col-md-6">
                <div class="card mb-6 h-100">
                    <h5 class="card-header">Formas de Pagamento</h5>
                    <div class="card-body">
                        <div class="row">
                            <div id="div_formapagamento_radio" class="col-12 mb-8">
                                <div class="form-check form-check-inline">
                                    <input name="collapsible-payment" class="form-check-input" type="radio" value="" id="collapsible-payment-cash" checked="" />
                                    <label class="form-check-label" for="collapsible-payment-cash">Pix</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input name="collapsible-payment" class="form-check-input" type="radio" value="" id="collapsible-payment-cc" />
                                    <label class="form-check-label" for="collapsible-payment-cc">Cartão de Crédito</label>
                                </div>
                            </div>

                            <div id="div_formapagamento_conteudo" class="col-12">
                            <div id="div_formapagamento_pix">
                                <div class="row g-5">
                                    <div class="col-12 col-md-6">
                                        <form id="pixForm" class="row g-5" onsubmit="return false">
                                            <div class="col-12">
                                                <label for="pixChaveValue" class="form-label">Chave Pix ACECA</label>
                                                <input id="pixChaveValue" name="pixChaveValue" class="form-control" type="text" placeholder="Chave Pix Aceca" readonly disabled />
                                            </div>
                                            <div class="col-12">
                                                <div class="form-floating form-floating-outline">
                                                    <input id="pixChaveRandonValue" name="pixChaveRandonValue" class="form-control" type="text" placeholder="Chave Pix Aleatória Aceca" />
                                                    <label for="pixChaveRandonValue">Chave Pix Aleatória</label>
                                                </div>
                                            </div>
                                            <!-- Espaçador - mantém a linha de botões na mesma posição do form de Cartão
                                                 (que tem uma linha a mais aqui: "Salvar para compras futuras?"). -->
                                            <div class="col-12 mt-6" style="visibility: hidden;" aria-hidden="true">
                                                <div class="form-check form-switch">
                                                    <input type="checkbox" class="form-check-input" disabled tabindex="-1" />
                                                    <label>.</label>
                                                </div>
                                            </div>
                                            <div class="col-12 mt-6 d-flex align-items-center gap-4">
                                                <div>
                                                    <button type="submit" class="btn btn-primary me-sm-3 me-1">Pagar</button>
                                                    <button type="reset" class="btn btn-outline-secondary">Cancelar</button>
                                                </div>
                                                <div id="div_logopix" class="ms-auto">
                                                    <img src="~/img/icons/payments/logo_pix.png" alt="Pix powered by Banco Central" style="max-height: 48px;">
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                    <div id="div_qr" class="col-12 col-md-6 d-flex flex-column">
                                        <label class="form-label" style="visibility: hidden;">.</label>
                                        <div id="titlepix" class="bg-label-primary rounded d-flex align-items-center px-4" style="height: 3.125rem;">
                                            <i class="icon-base ri ri-qr-code-line icon-20px me-2"></i>
                                            <span class="fw-medium">PIX ACECA</span>
                                        </div>
                                        <div id="div_qrpix" class="flex-grow-1 added-cards d-flex flex-column align-items-center justify-content-center text-center mt-5">
                                            <img id="pixQrCodeImg" class="img-fluid rounded border border-primary border-2 p-2 bg-white mb-3 d-none" alt="QR Code Pix" style="max-width: 220px;" />
                                            <small id="pixMensagem" class="text-muted">Carregando chave Pix...</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- / Cartão de Crédito -->
                            <div id="div_formapagamento_cartoes" class="pagamento-oculto">
                                <div class="row g-5">
                                    <div class="col-12 col-md-6">
                                        <form id="creditCardForm" class="row g-5" onsubmit="return false">
                                            <div class="col-12">
                                                <!-- Label invisível - só pra igualar a altura desta linha com a "Chave Pix
                                                     ACECA" do form de Pix (que tem label fora do campo, não flutuante). -->
                                                <label class="form-label" style="visibility: hidden;">.</label>
                                                <div class="input-group input-group-merge">
                                                    <div class="form-floating form-floating-outline">
                                                        <input id="paymentCardNumero" name="paymentCardNumero" class="form-control credit-card-mask" type="text" placeholder="1356 3215 6548 7898" aria-describedby="paymentCard2" />
                                                        <label for="paymentCardNumero">Número do Cartão</label>
                                                    </div>
                                                    <span class="input-group-text cursor-pointer" id="paymentCard2"><span class="card-type"></span></span>
                                                </div>
                                            </div>
                                            <div class="col-12 col-xl-6 col-lg-12">
                                                <div class="form-floating form-floating-outline">
                                                    <input type="text" id="paymentName" class="form-control" placeholder="John Doe" />
                                                    <label for="paymentName">Nome</label>
                                                </div>
                                            </div>
                                            <div class="col-6 col-xl-3 col-lg-6">
                                                <div class="form-floating form-floating-outline">
                                                    <input type="text" id="paymentExpiryDate" class="form-control expiry-date-mask" placeholder="MM/YY" />
                                                    <label for="paymentExpiryDate">Data Expiração</label>
                                                </div>
                                            </div>
                                            <div class="col-6 col-xl-3 col-lg-6">
                                                <div class="input-group input-group-merge">
                                                    <div class="form-floating form-floating-outline">
                                                        <input type="text" id="paymentCvv" class="form-control cvv-code-mask" maxlength="3" placeholder="654" />
                                                        <label for="paymentCvv">CVV Code</label>
                                                    </div>
                                                    <span class="input-group-text cursor-pointer" id="paymentCvv2"><i class="ri-question-line" data-bs-toggle="tooltip" data-bs-placement="top" title="Código de verificação do cartão"></i></span>
                                                </div>
                                            </div>
                                            <div class="col-12 mt-6">
                                                <div class="form-check form-switch">
                                                    <input type="checkbox" class="form-check-input" id="future-billing" />
                                                    <label for="future-billing">Salvar para compras futuras?</label>
                                                </div>
                                            </div>
                                            <div class="col-12 mt-6">
                                                <button type="submit" class="btn btn-primary me-sm-3 me-1">Salvar</button>
                                                <button type="reset" class="btn btn-outline-secondary">Limpar</button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div id="titlecartoes" class="bg-label-warning rounded d-flex align-items-center px-4 mb-4" style="height: 3.125rem;">
                                            <i class="icon-base ri ri-bank-card-line icon-20px me-2"></i>
                                            <span class="fw-medium">Meus Cartões</span>
                                        </div>
                                        <div id="div_meuscartoes" class="added-cards">
                                            <div class="cardMaster bg-lightest p-4 rounded mb-6">
                                                <div class="d-flex justify-content-between flex-sm-row flex-column">
                                                    <div class="card-information me-2">
                                                        <img class="mb-2 img-fluid" src="~/img/icons/payments/mastercard.png" alt="Master Card">
                                                        <div class="d-flex align-items-center mb-2 flex-wrap gap-2">
                                                            <h6 class="mb-0 me-2">Zezinho Silva</h6>
                                                            <span class="badge bg-label-primary rounded-pill">Principal</span>
                                                        </div>
                                                        <span class="card-number">&#8727;&#8727;&#8727;&#8727; &#8727;&#8727;&#8727;&#8727; 9856</span>
                                                    </div>
                                                    <div class="d-flex flex-column text-start text-lg-end">
                                                        <div class="d-flex order-sm-0 order-1 mt-sm-0 mt-4">
                                                            <button class="btn btn-sm btn-outline-primary me-4" data-bs-toggle="modal" data-bs-target="#editCCModal">Editar</button>
                                                            <button class="btn btn-sm btn-outline-danger">Apagar</button>
                                                        </div>
                                                        <small class="mt-4 order-sm-1 order-0">Cartão expira em 12/26</small>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="cardMaster bg-lightest p-4 rounded">
                                                <div class="d-flex justify-content-between flex-sm-row flex-column">
                                                    <div class="card-information me-4">
                                                        <img class="mb-2 img-fluid" src="~/img/icons/payments/visa.png" alt="Visa Card">
                                                        <h6 class="mb-2">Virgulino SOuza</h6>
                                                        <span class="card-number">&#8727;&#8727;&#8727;&#8727; &#8727;&#8727;&#8727;&#8727; 5896</span>
                                                    </div>
                                                    <div class="d-flex flex-column text-start text-lg-end">
                                                        <div class="d-flex order-sm-0 order-1 mt-sm-0 mt-4">
                                                            <button class="btn btn-sm btn-outline-primary me-4" data-bs-toggle="modal" data-bs-target="#editCCModal">Editar</button>
                                                            <button class="btn btn-sm btn-outline-danger">Apagar</button>
                                                        </div>
                                                        <small class="mt-4 order-sm-1 order-0">Cartão expira em 02/24</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Modal -->
                                        @await Html.PartialAsync("../_Partials/_Modals/ModalEditCc")
                                        <!--/ Modal -->
                                    </div>
                                </div>
                            </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
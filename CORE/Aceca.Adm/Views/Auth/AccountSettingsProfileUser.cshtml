@{
    //ViewData["Title"] = "User Profile - Profile";
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-profile.css" />
    <style>
        /* Coluna "control" (1ª, vazia) do grid de Coleção - sem uso agora que o mobile é
           resolvido via CSS puro abaixo (ver bloco @@media), então fica sempre oculta. */
        #tblColecaoTopFases thead th:first-child,
        #tblColecaoTopFases tbody td:first-child {
            display: none !important;
        }

        /* Mobile: em vez de depender da extensão DataTables Responsive (já causou
           incompatibilidade de versão com o DataTables core do projeto - ver commit
           9b2fcca), empilha cada linha em formato de cartão via CSS puro. Solução
           independente de qualquer lib/versão, então não quebra de novo. */
        @@media (max-width: 575.98px) {
            #tblColecaoTopFases thead {
                display: none;
            }

            #tblColecaoTopFases {
                display: block;
                width: 100% !important;
                /* Espaçamento lateral - sem isso os cartões ficavam colados na borda
                   do card pai. box-sizing:border-box pra caber nos mesmos 100% da tbody/tr. */
                padding: 0 0.5rem;
                box-sizing: border-box;
            }

            #tblColecaoTopFases tbody,
            #tblColecaoTopFases tr,
            #tblColecaoTopFases td {
                display: block;
                width: 100% !important;
            }

            #tblColecaoTopFases tr {
                margin-bottom: 0.75rem;
                border: 1px solid #e0e0e0;
                border-radius: 8px;
                padding: 0.5rem 0.75rem;
                box-sizing: border-box;
            }

            #tblColecaoTopFases td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 0.75rem;
                padding: 0.35rem 0 !important;
                border: none !important;
                text-align: right;
            }

            #tblColecaoTopFases td::before {
                content: attr(data-label);
                font-weight: 600;
                color: #566a7f;
                text-align: left;
            }
        }
    </style>
}

@section PageScripts {
    <script src="~/js/auth/pages-auth-account-settings-user.js" asp-append-version="true" defer></script>
}

@* ************** Content ************** *@
<!-- Header -->
<div id="div_header" class="row">
    <div class="col-12">
        <div class="card mb-6">
            <div class="user-profile-header-banner">
                <img src="~/img/pages/profile-banner.png" alt="Banner image" class="rounded-top" style="height: 125px !important;">
            </div>
            <div class="user-profile-header d-flex flex-column flex-lg-row text-sm-start text-center mb-4">
                <div class="flex-shrink-0 mt-n2 mx-sm-0 mx-auto">
                    <img id="img_HeaderAvatar" src="~/img/avatars/socio/imgAvatarAceca.png" alt="user image" class="d-block h-auto ms-0 ms-sm-5 rounded user-profile-img">
                </div>
                <div class="flex-grow-1 mt-3 mt-lg-5">
                    <div class="d-flex align-items-md-end align-items-sm-start align-items-center justify-content-md-between justify-content-start mx-5 flex-md-row flex-column gap-4">
                        <div class="user-profile-info">
                            <h4 id="sp_HeaderNome" class="mb-2 mt-lg-6">-</h4>
                            <ul class="list-inline mb-0 d-flex align-items-center flex-wrap justify-content-sm-start justify-content-center gap-4">
                                <li hidden="hidden" class="list-inline-item">
                                    <i class='ri-palette-line me-2 ri-24px'></i><span class="fw-medium">Sócio</span>
                                </li>
                                <li class="list-inline-item">
                                    <i class='ri-map-pin-line me-2 ri-24px'></i><span id="sp_HeaderCidade" class="fw-medium">-</span>
                                </li>
                                <li class="list-inline-item">
                                    <i class='ri-calendar-line me-2 ri-24px'></i><span id="sp_HeaderSocioDesde" class="fw-medium">-</span>
                                </li>
                            </ul>
                        </div>
                        <a id="btnAtualizar" asp-controller="Auth" asp-action="AccountSettings" class="btn btn-primary">
                            <i class='ri-edit-box-line ri-16px me-1_5'></i>Atualizar Dados
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- User Profile Content -->
<div class="row">
    <!-- Sobre User -->
    @* col-md-3 tirado de propósito: 3 colunas de 25%/25%/50% cabem bem em desktop, mas em
       tablet (iPad Air 820px, Samsung 8" ~800-1280px - já caem no breakpoint md, ≥768px)
       25% de largura é pouco pro conteúdo real (endereço, telefone, e-mail), quebrando
       linha feio. Empilha até lg (992px), só forma 3 colunas a partir daí. *@
    <div id="div_sobre" class="col-12 col-lg-3 col-xl-3">
        <div class="card card-action mb-6 h-100">
            <div class="card-header align-items-center">
                <h5 class="card-action-title mb-0"><i class='ri-questionnaire-line ri-24px text-body me-4'></i>Sobre</h5>
            </div>
            <hr class="my-0">
            <div class="card-body pt-3">

                @* <small class="card-text text-uppercase text-muted small">Sobre</small> *@
                <ul class="list-unstyled my-3 py-1">
                    <li class="d-flex align-items-center mb-4"><i class="ri-user-3-line ri-24px"></i><span class="fw-medium mx-2">Nome:</span> <span id="sp_Nome">-</span></li>
                    <li class="d-flex align-items-center mb-4"><i class="ri-check-line ri-24px"></i><span class="fw-medium mx-2">Usuário:</span> <span id="sp_Usuario">-</span></li>
                    <li class="d-flex align-items-center mb-4"><i class="ri-star-smile-line ri-24px"></i><span class="fw-medium mx-2">Perfil:</span> <span id="sp_Perfil">-</span></li>
                    <li class="d-flex align-items-center mb-4"><i class="ri-calendar-line ri-24px"></i><span class="fw-medium mx-2">Aniversário:</span> <span id="sp_Aniversario">-</span></li>
                </ul>

                <small class="card-text text-uppercase text-muted small">Contatos</small>
                <ul class="list-unstyled my-3 py-1">
                    <li class="d-flex align-items-center mb-4"><i class="ri-phone-line ri-24px"></i><span class="fw-medium mx-2">Telefone:</span> <span id="sp_Telefone">-</span></li>
                    <li class="d-flex align-items-center mb-2"><i class="ri-mail-open-line ri-24px"></i><span class="fw-medium mx-2">E-mail:</span> <span id="sp_Email">-</span></li>
                </ul>

                <small class="card-text text-uppercase text-muted small">Correspondência</small>
                <ul class="list-unstyled mb-0 mt-3 pt-1">
                    <li class="d-flex align-items-center mb-4">
                        <i class="ri-map-pin-line ri-24px text-body me-2"></i>
                        <div class="d-flex flex-wrap"><span class="fw-medium me-2">Endereço:</span><span id="sp_Endereco">-</span></div>
                    </li>
                </ul>

            </div>
        </div>
    </div>

    <!--/ Actividade Login -->
    <div id="div_atividade" class="col-12 col-lg-3 col-xl-3">
        <div class="card card-action mb-6 h-100">
            <div class="card-header align-items-center">
                <h5 class="card-action-title mb-0"><i class='ri-bar-chart-2-line ri-24px text-body me-4'></i>Atividade</h5>
            </div>
            <hr class="my-0">
            <div class="card-body pt-3">
                <ul class="timeline card-timeline mb-0 my-3 py-1">
                    <li class="timeline-item timeline-item-transparent">
                        <span class="timeline-point timeline-point-primary"></span>
                        <div class="timeline-event">
                            <div class="timeline-header mb-3">
                                <h6 id="tl_Titulo_1" class="mb-0">-</h6>
                                <small id="tl_Data_1" class="text-muted">-</small>
                            </div>
                            <p id="tl_Local_1" class="mb-2">-</p>

                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <div class="d-flex flex-wrap align-items-center">
                                    <div class="avatar avatar-sm me-2">
                                        <img src="~/img/avatars/socio/imgAvatarAceca.png" alt="Avatar" class="rounded-circle tl-avatar-img" />
                                    </div>
                                    <div>
                                        <p class="mb-0 small fw-medium tl-avatar-nome">-</p>
                                        <small class="tl-avatar-perfil">-</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                    <li class="timeline-item timeline-item-transparent">
                        <span class="timeline-point timeline-point-success"></span>
                        <div class="timeline-event">
                            <div class="timeline-header mb-3">
                                <h6 id="tl_Titulo_2" class="mb-0">-</h6>
                                <small id="tl_Data_2" class="text-muted">-</small>
                            </div>
                            <p id="tl_Local_2" class="mb-2">-</p>
                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <div class="d-flex flex-wrap align-items-center">
                                    <div class="avatar avatar-sm me-2">
                                        <img src="~/img/avatars/socio/imgAvatarAceca.png" alt="Avatar" class="rounded-circle tl-avatar-img" />
                                    </div>
                                    <div>
                                        <p class="mb-0 small fw-medium tl-avatar-nome">-</p>
                                        <small class="tl-avatar-perfil">-</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                    <li class="timeline-item timeline-item-transparent">
                        <span class="timeline-point timeline-point-info"></span>
                        <div class="timeline-event">
                            <div class="timeline-header mb-3">
                                <h6 id="tl_Titulo_3" class="mb-0">-</h6>
                                <small id="tl_Data_3" class="text-muted">-</small>
                            </div>
                            <p id="tl_Local_3" class="mb-2">-</p>

                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <div class="d-flex flex-wrap align-items-center">
                                    <div class="avatar avatar-sm me-2">
                                        <img src="~/img/avatars/socio/imgAvatarAceca.png" alt="Avatar" class="rounded-circle tl-avatar-img" />
                                    </div>
                                    <div>
                                        <p class="mb-0 small fw-medium tl-avatar-nome">-</p>
                                        <small class="tl-avatar-perfil">-</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!--/ Grid Colecao -->
    <div id="div_grid_colecao" class="col-12 col-lg-6 col-xl-6">
        <div class="card card-action mb-6 h-100">
            <div class="card-header align-items-center">
                <h5 class="card-action-title mb-0"><i class='ri-archive-line ri-24px text-body me-4'></i>Coleção</h5>
            </div>
            <hr class="my-0">
            <div class="card-datatable table-responsive pb-0 mb-n4 pt-3">
                <table id="tblColecaoTopFases" class="table datatable-project table-border-bottom-0" width="100%">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Fase</th>
                            <th>Tipo</th>
                            <th>Status da Minha Coleção</th>
                            <th>Tenho</th>
                            <th>Meus Interesses</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>

</div>

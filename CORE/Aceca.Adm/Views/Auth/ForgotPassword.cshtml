@{
    var pageApp = "ACECA";
    ViewData["Title"] = $"{pageApp} | Esqueci minha senha";
    Layout = $"~/Views/Shared/_BlankLayout.cshtml";
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
    <link rel="stylesheet" href="~/css/pages/auth-login.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
}

@section PageScripts {
    <script src="~/js/auth/pages-forgot.js" asp-append-version="true" defer></script>
}

<div class="position-relative login-bg-img">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner py-6 mx-4">
            <div class="pg-login">
                <div class="login-bg">
                    <div class="" style="position: absolute;inset: 0;"></div>
                </div>

                <div class="login-wrap">
                    <div class="login-card mt-1">
                        <div class="lc-logo">
                            <div class="lc-circle">
                                <img src="~/img/logo/logo.webp" loading="lazy" decoding="async" title="ACECA" alt="ACECA">
                            </div>
                            <div>
                                <span class="lc-aceca custom_text">ACECA</span>
                                <span class="lc-area">&Aacute;rea do S&oacute;cio</span>
                            </div>
                        </div>

                        <h2>Esqueceu sua senha?</h2>
                        <p class="lc-sub">Informe seu e-mail cadastrado e enviaremos um link para redefinir sua senha.</p>

                        <div id="forgotErr" class="login-err" role="alert" aria-live="polite" style="display:none"></div>
                        <div id="forgotOk"  class="login-ok"  role="status" aria-live="polite" style="display:none"></div>

                        <!--begin::Form-->
                            <form id="frmForgot" class="form" action="#" autocomplete="off" novalidate>

                                <div class="fg">
                                    <label for="fEmail">E-mail cadastrado</label>
                                    <input class="form-control"
                                           type="email"
                                           id="fEmail"
                                           name="fEmail"
                                           placeholder="seu@email.com.br"
                                           required
                                           autocomplete="email"
                                           inputmode="email">
                                </div>

                                <button type="submit" class="btn-entrar" id="btnForgot">
                                    <span class="btn-text">Enviar link de redefinição</span>
                                    <span class="btn-spinner" style="display:none;" aria-hidden="true">
                                        <i class="ri-loader-4-line ri-spin"></i> Enviando…
                                    </span>
                                </button>

                            </form>
                        <!--end::Form-->

                        <p class="lc-cadastro">Ainda n&atilde;o &eacute; S&oacute;cio? <a href="https://www.aceca.com.br/#contato">Solicite sua associa&ccedil;&atilde;o</a></p>
                        <a href="/Auth/Index" class="back-site">← Voltar ao Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

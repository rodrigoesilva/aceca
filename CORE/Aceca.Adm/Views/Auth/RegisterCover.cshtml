@{
    Layout = $"~/Views/Shared/_BlankLayout.cshtml";
}

@{
    var urlStyleCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/css/style.css");
    var urlAuthLoginCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/css/pages/auth-login.css");
}

@section PageStyles {
    <link rel="stylesheet" href="@urlAuthLoginCss">
    <link rel="stylesheet" href="@urlStyleCss">
}

@section PageScripts {
    <script src="~/js/auth/pages-auth-register.js" asp-append-version="true" defer></script>
}

@* ************** Content ************** *@

        <div class="position-relative login-bg-img">
            <div class="authentication-wrapper authentication-basic container-p-y">
                <div class="authentication-inner py-6 mx-4">
                    <div class="pg-login">
                        <div class="login-bg">
                            <div class="" style="position: absolute;inset: 0;"></div>
                        </div>

                        <div class="login-wrap">
                            <div class="login-card mt-1">
                                <div class="lc-logo">
                                    <div class="lc-circle">
                                        <img src="~/img/logo/logo.webp" loading="lazy" decoding="async" title="ACECA" alt="ACECA">
                                    </div>
                                    <div>
                                        <span class="lc-aceca custom_text">ACECA</span>
                                        <span class="lc-area">&Aacute;rea do S&oacute;cio</span>
                                    </div>
                                </div>
                                <h2>Criar conta</h2>
                                <p class="lc-sub">Experimente ser S&oacute;cio ACECA gratuitamente por <strong>@ViewBag.DuracaoTesteHoras horas</strong>, sem compromisso.</p>
                                <div id="registerErr" class="login-err" style="display:none"></div>

                                @* Flags vindas do servidor (GoogleCallback/RegisterCover) - nunca do cliente,
                                   pra JS decidir qual passo mostrar sem confiar em nada editável. *@
                                <div id="registerServerFlags" style="display:none"
                                     data-email-ja-cadastrado="@(ViewBag.EmailJaCadastrado == true ? "1" : "0")"
                                     data-google-token-expirado="@(ViewBag.GoogleTokenExpirado == true ? "1" : "0")"></div>

                                <!-- Passo 1: escolha do método -->
                                <div id="passoEscolha" style="@(ViewBag.GoogleToken != null ? "display:none" : "")">
                                    <a href="/Auth/GoogleLogin" class="btn-google-fake" id="btnGoogleLogin">
                                        <i class="ri-google-fill ri-20px"></i> Continuar com o Google
                                    </a>

                                    <div class="divisor-ou"><span>ou</span></div>

                                    <button type="button" class="btn-entrar" id="btnContinuarEmail">
                                        Continuar com um e-mail
                                    </button>
                                </div>

                                <!-- Passo 2: dados + e-mail (escondido até clicar em "Continuar com um e-mail") -->
                                <form id="frmCadastroTeste" class="form" style="display:none" autocomplete="off" novalidate>

                                    <div class="fg">
                                        <label for="rCpf">CPF</label>
                                        <input class="form-control" type="text" id="rCpf" name="rCpf" placeholder="000.000.000-00" required inputmode="numeric" maxlength="14">
                                        <span class="fg-erro-campo" id="rCpfErro"></span>
                                    </div>

                                    <div class="fg">
                                        <label for="rEmail">E-mail pessoal</label>
                                        <input class="form-control" type="email" id="rEmail" name="rEmail" placeholder="seu@email.com.br" required autocomplete="email" inputmode="email">
                                        <span class="fg-erro-campo" id="rEmailErro"></span>
                                    </div>

                                    <div class="mb-3 py-1">
                                        <div class="form-check-teste">
                                            <input type="checkbox" id="rTermos" name="rTermos" required>
                                            <label for="rTermos">Concordo com os <a href="#policyModal" data-bs-toggle="modal">Termos de Uso e a Pol&iacute;tica de Privacidade</a> da ACECA.</label>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn-entrar" id="btnContinuarCadastro">
                                        <span class="btn-text">Continuar</span>
                                        <span class="btn-spinner" style="display:none;" aria-hidden="true">
                                            <i class="ri-loader-4-line ri-spin"></i> Enviando…
                                        </span>
                                    </button>

                                    <button type="button" class="btn-voltar-escolha" id="btnVoltarEscolha">&larr; Voltar</button>
                                </form>

                                @* Passo 2b: só o CPF - usado quando o e-mail já veio verificado pelo Google
                                   (GoogleCallback). Nome/e-mail não são campos editáveis aqui de propósito -
                                   quem garante que baterem com o que o Google confirmou é o ggToken, guardado
                                   em cache no servidor (ver AuthController.CadastroTesteGoogleFinalizar). *@
                                <form id="frmCadastroGoogle" class="form" style="@(ViewBag.GoogleToken != null ? "" : "display:none")" autocomplete="off" novalidate>
                                    <p class="lc-google-continuando">
                                        Continuando como <strong>@ViewBag.GoogleNome</strong><br>
                                        <span class="text-muted">@ViewBag.GoogleEmail</span>
                                    </p>

                                    <input type="hidden" id="ggToken" value="@ViewBag.GoogleToken">

                                    <div class="fg">
                                        <label for="ggCpf">CPF</label>
                                        <input class="form-control" type="text" id="ggCpf" name="ggCpf" placeholder="000.000.000-00" required inputmode="numeric" maxlength="14">
                                        <span class="fg-erro-campo" id="ggCpfErro"></span>
                                    </div>

                                    <div class="mb-3 py-1">
                                        <div class="form-check-teste">
                                            <input type="checkbox" id="ggTermos" name="ggTermos" required>
                                            <label for="ggTermos">Concordo com os <a href="#policyModal" data-bs-toggle="modal">Termos de Uso e a Pol&iacute;tica de Privacidade</a> da ACECA.</label>
                                        </div>
                                    </div>

                                    <button type="submit" class="btn-entrar" id="btnContinuarCadastroGoogle">
                                        <span class="btn-text">Continuar</span>
                                        <span class="btn-spinner" style="display:none;" aria-hidden="true">
                                            <i class="ri-loader-4-line ri-spin"></i> Enviando…
                                        </span>
                                    </button>

                                    <a href="/Auth/RegisterCover" class="btn-voltar-escolha">&larr; Voltar</a>
                                </form>

                                <p class="lc-cadastro">J&aacute; &eacute; S&oacute;cio? <a href="/Auth/Index">Fazer login</a></p>
                                <a href="https://www.aceca.com.br/" class="back-site">&larr; Voltar ao Site</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

@await Html.PartialAsync("../_Partials/_Modals/ModalPolicyTerms")

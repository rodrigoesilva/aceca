@{
    var pageApp = "ACECA";
    ViewData["Title"] = $"{pageApp} | Redefinir senha";
    Layout = $"~/Views/Shared/_BlankLayout.cshtml";

    var token = ViewBag.Token as string ?? "";
    var email = ViewBag.Email as string ?? "";
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css">
    <link rel="stylesheet" href="~/css/pages/auth-login.css?v=1.0.1">
    <link rel="stylesheet" href="~/css/style.css">
}

@section PageScripts {
    <script>
        // Injeta token e email no contexto JS de forma segura
        window._resetCtx = {
            token: '@Html.Raw(Uri.EscapeDataString(token))',
            email: '@Html.Raw(Uri.EscapeDataString(email))'
        };
    </script>
    <script src="~/js/auth/pages-reset.js" asp-append-version="true"></script>
}

<div class="position-relative login-bg-img">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner py-6 mx-4">
            <div class="pg-login">
                <div class="login-bg">
                    <div class="" style="position: absolute;inset: 0;"></div>
                </div>
                
                <div class="login-wrap">
                    <div class="login-card mt-1">
                        <div class="lc-logo">
                            <div class="lc-circle">
                                <img src="~/img/logo/logo.webp" loading="lazy" decoding="async" title="ACECA" alt="ACECA">
                            </div>
                            <div>
                                <span class="lc-aceca custom_text">ACECA</span>
                                <span class="lc-area">&Aacute;rea do S&oacute;cio</span>
                            </div>
                        </div>

                        <h2>Redefinir senha</h2>
                        <p class="lc-sub">Preencha os campos abaixo para criar sua nova senha.</p>

                        <div id="resetErr" class="login-err" role="alert" aria-live="polite" style="display:none"></div>

                        <!--begin::Form-->
                        <form id="frmReset" class="form" action="#" autocomplete="off" novalidate>

                            <!--{{!-- E-mail (preenchido automaticamente, readonly) --}}-->
                            <div class="fg">
                                <label for="rEmail">E-mail</label>
                                <input class="form-control"
                                       type="email"
                                       id="rEmail"
                                       name="rEmail"
                                       placeholder="seu@email.com.br"
                                       required
                                       autocomplete="email"
                                       inputmode="email">
                            </div>

                            <!--{{!-- Nova senha --}}-->
                            <div class="fg pwd-fg form-password-toggle">
                                <label for="rSenha">Nova senha</label>
                                <input class="form-control"
                                       type="password"
                                       id="rSenha"
                                       name="rSenha"
                                       placeholder="Mín. 8 caracteres e 1 número"
                                       required
                                       autocomplete="new-password">
                                <button type="button" class="eye-btn cursor-pointer" title="Mostrar/ocultar senha" aria-label="Mostrar ou ocultar senha" data-target="rSenha">
                                    <i class="ri-eye-off-line ri-20px" aria-hidden="true"></i>
                                </button>
                            </div>

                            <!--{{!-- Confirmação de senha --}}-->
                            <div class="fg pwd-fg form-password-toggle">
                                <label for="rConfirmSenha">Confirmar nova senha</label>
                                <input class="form-control"
                                       type="password"
                                       id="rConfirmSenha"
                                       name="rConfirmSenha"
                                       placeholder="Repita a nova senha"
                                       required
                                       autocomplete="new-password">
                                <button type="button" class="eye-btn cursor-pointer" title="Mostrar/ocultar senha" aria-label="Mostrar ou ocultar senha" data-target="rConfirmSenha">
                                    <i class="ri-eye-off-line ri-20px" aria-hidden="true"></i>
                                </button>
                            </div>

                            <!--{{!-- Indicador visual de força --}}
                            <div class="pwd-strength-wrap" id="pwdStrengthWrap" style="display:none">
                                <div class="pwd-strength-bar">
                                    <div class="pwd-strength-fill" id="pwdStrengthFill"></div>
                                </div>
                                <span class="pwd-strength-label" id="pwdStrengthLabel"></span>
                            </div>
                            -->

                            <button type="submit" class="btn-entrar" id="btnReset">
                                <span class="btn-text">Salvar nova senha</span>
                                <span class="btn-spinner" style="display:none;" aria-hidden="true">
                                    <i class="ri-loader-4-line ri-spin"></i> Salvando…
                                </span>
                            </button>

                        </form>
                        <!--end::Form-->

                        <p class="lc-cadastro">Ainda n&atilde;o &eacute; S&oacute;cio? <a href="https://www.aceca.com.br/#contato">Solicite sua associa&ccedil;&atilde;o</a></p>
                        <a href="/Auth/Index" class="back-site">← Voltar ao Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
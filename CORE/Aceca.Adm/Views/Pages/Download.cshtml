@{
    Layout = $"~/Views/Shared/{@TempData["Layout"]}.cshtml";

    // Ver Helper/AssetUrlHelper.cs - dentro de @section, só a 1ª tag com
    // asp-append-version é processada pelo Tag Helper; as demais ficam com "~/"
    // literal (JS não carrega).
    var urlPagesDownload = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/pages/pages-download.js");
    var urlFormsSelects = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/js/forms-selects.js");

    // Cache-busting manual (Program.cs aplica Cache-Control: max-age=604800 em TODO
    // arquivo estático) - sem isso, o navegador continua servindo a versão antiga do
    // vendor em cache mesmo depois do arquivo ser atualizado no servidor (foi exatamente
    // isso que aconteceu na atualização 2.1.0 -> 3.0.8 do Responsive).
    var urlResponsiveCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/datatables-responsive-bs5/responsive.dataTables.min.css");
    var urlResponsiveJs = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/datatables-responsive-bs5/dataTables.responsive.js");

    // Mesmo bug (@section com 2+ tags "~/" estáticas quebra a resolução de parte delas) -
    // essas 5 (CSS) e 3 (JS) nunca tinham sido cobertas, só as do Responsive acima.
    var urlRowGroupCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/datatables-rowgroup-bs5/rowgroup.bootstrap5.css");
    var urlMonthSelectCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/flatpickr/plugins/monthSelect/style.css");
    var urlDateRangePickerCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/bootstrap-daterangepicker/bootstrap-daterangepicker.css");
    var urlTimepickerCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/jquery-timepicker/jquery-timepicker.css");
    var urlPickrThemesCss = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/pickr/pickr-themes.css");
    var urlDateRangePickerJs = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/bootstrap-daterangepicker/bootstrap-daterangepicker.js");
    var urlTimepickerJs = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/jquery-timepicker/jquery-timepicker.js");
    var urlPickrJs = Aceca.Adm.Helper.AssetUrlHelper.ComVersao(Url, AppEnvironment, "~/vendor/libs/pickr/pickr.js");
}

@section PageStyles {
    <style>
        /* Mobile: a coluna de controle (só o ícone de expandir) herdava o padding padrão
           do tema (~1.25rem cada lado) mesmo vazia - sobrava espaço em branco, sufocando
           a coluna Título. Reduz só o padding (a largura declarada no columnDefs, que é o
           que o Responsive usa pra calcular quantas colunas cabem, foi compensada em
           pages-download.js). */
        #tblDownload thead th:first-child,
        #tblDownload tbody td.control {
            padding-left: 0.25rem !important;
            padding-right: 0 !important;
        }
    </style>
}

@section VendorStyles {

    <!-- Row Group CSS -->
    <link rel="stylesheet" href="@urlRowGroupCss">

    <!-- Flat Picker - Calendar -->
    <link rel="stylesheet" href="@urlMonthSelectCss">
    <!-- DatePicker Range -->
    <link rel="stylesheet" href="@urlDateRangePickerCss" />

    <link rel="stylesheet" href="@urlTimepickerCss" />
    <link rel="stylesheet" href="@urlPickrThemesCss" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datetimepicker/4.17.37/css/bootstrap-datetimepicker.min.css" integrity="sha512-WWc9iSr5tHo+AliwUnAQN1RfGK9AnpiOFbmboA0A0VJeooe69YR2rLgHw13KxF1bOSLmke+SNnLWxmZd8RTESQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- CSS PAGE -->
    <link rel="stylesheet" href="~/css/zoom.css" asp-append-version="true">

    <link rel="stylesheet" href="@urlResponsiveCss" />
}

@section VendorScripts {

    <!-- DatePicker Range -->
    <script src="@urlDateRangePickerJs" defer></script>

    <script src="@urlTimepickerJs" defer></script>
    <script src="@urlPickrJs" defer></script>

    <script src="@urlResponsiveJs" defer></script>

}

@section PageScripts {

    <!-- Causa real do erro (Cannot read properties of undefined (reading 'addEventListener')
         em bindEvents): o flatpickr detecta user-agent mobile e troca pro <input type="date">
         nativo em vez de montar o calendário, e o plugin monthSelect não lida com esse modo -
         corrigido com disableMobile:true onde o flatpickr() é chamado. Versão do plugin fixada
         em 4.6.13 só por consistência com o core local. -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/pt.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/plugins/monthSelect/index.js" defer></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datetimepicker/4.17.37/js/bootstrap-datetimepicker.min.js" defer></script>

    <script src="@urlPagesDownload" defer></script>
    <!-- Select Dropdownlist -->
    <script src="@urlFormsSelects" defer></script>
}

@* ************** Filtros ************** 
<div class="card mb-6">
    <div class="card-widget-separator-wrapper">
        <div class="card-body card-widget-separator">
            <div class="head-label-filtro text-start">
                <h5 class="card-title mb-0 title-filtro">Filtros</h5>
            </div>

            <div class="row gy-4 gy-sm-1 pt-4 gap-4 gap-md-0">

                <!-- Mes -->
                <div class="div_MarcaMes col-sm-6 col-lg-4">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 row gap-4 gap-md-0">
                        <div id="divDT">
                            <p class="mb-1">* Per&iacute;odo</p>
                            <input id="dt_Periodo" name="dt_Periodo" class="form-control dt-calendar-year" type="text" placeholder="MM/YYYY" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <!-- Tipo-->
                <div class="div_MarcaTipo col-sm-6 col-lg-4">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 row gap-4 gap-md-0">
                        <div>
                            <p class="mb-1">* Tipo</p>
                            <select id="cmb_MarcaTipo" class="select2 form-select form-select">
                                <option value="-1">-- Selecionar --</option>
                            </select>
                        </div>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none me-6">
                </div>

                <!-- Botoes -->
                <div class="div_Botoes col-sm-6 col-lg-4">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 row gap-4 gap-md-0">
                        <div class="d-flex justify-content-center align-content-center flex-wrap gap-4 pt-8">
                            <!-- 
                                <button type="button" class="btn btn-label-primary btn-filter waves-effect">
                                <span class="tf-icons ri-filter-2-line ri-16px me-1_5"></span>Filtrar Dados
                                </button>
                            -->
                            <button type="button" class="btn btn-label-secondary waves-effect btn-filter-clear">
                                <span class="tf-icons ri-eraser-line ri-16px me-1_5"></span>Limpar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
*@
@*************** Content List Table ************** *@
<div class="card">
    <div class="card-datatable table-responsive pt-0">
        <table id="tblDownload" class="datatables-basic table table-hover display responsive" width="100%">
            <thead>
                <tr>
                    <th></th>
                    <th>Imagem</th>
                    <th>Tipo</th>
                    <th>T&iacute;tulo</th>
                    <!-- w-50 removida: o Responsive mede a largura mínima de cada coluna
                         clonando só o <th> num <div> de 1px de largura - width:% nesse
                         contexto resolve pra uma fração de pixel, fazendo o Responsive achar
                         que Descrição não precisa de espaço nenhum no cálculo de quantas
                         colunas cabem no mobile. -->
                    <th class="text-start">Descri&ccedil;&atilde;o</th>
                    <th class="text-nowrap text-center">Formato</th>
                    <th class="text-nowrap text-center" style="text-align:center!important">Inclu&iacute;do por</th>
                    <th>Inclu&iacute;do por</th>
                    <th>A&ccedil;&otilde;es</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Modal Add new Item -->
<div class="offcanvas offcanvas-end" id="pop-add-new-item">
    <div class="offcanvas-header border-bottom">
        <input type="hidden" id="hdId" name="hdId" value="0"/>
        <input type="hidden" id="hdPaisCategoriaId" name="hdPaisCategoriaId" value="0" />
        <h5 class="offcanvas-title" id="h5-pop-add-new-item">Novo Registro</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body flex-grow-1">
        <form class="form-add-new-item pt-0 row g-3" id="form-pop-add-new-item" onsubmit="return false">
            <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <span id="line_item_01" class="input-group-text"></span>
                    <div class="form-floating form-floating-outline">
                        <input type="text" id="pop_line_item_01" class="form-control dt-line-01" name="pop_line_item_01"
                               placeholder="Nome" aria-label="Nome" aria-describedby="line_item_01"/>
                        <label for="pop_line_item_01">Nome</label>
                    </div>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <span id="line_item_02" class="input-group-text"></span>
                    <div class="form-floating form-floating-outline">
                        <textarea class="form-control h-px-100 dt-line-02" id="pop_line_item_02" name="pop_line_item_02" placeholder="Descrição..."></textarea>
                        <label for="pop_line_item_02">Descri&ccedil;&atilde;o</label>
                    </div>
                </div>
            </div>
            <div id="pop_div_line_item_04" name="PaisCategoria" class="col-sm-12">
                <div class="form-floating form-floating-outline">
                    <select id="cmb_PaisCategoria" name="cmb_PaisCategoria"
                            class="form-select select2 dt-line-04"
                            data-allow-clear="true">
                        <option value="-1">-- Selecionar --</option>
                    </select>
                    <label for="cmb_PaisCategoria">Categoria</label>
                </div>
            </div>
            <div class="col-sm-12">
                <div class="input-group input-group-merge">
                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" id="pop_line_item_05" class="form-check-input dt-line-05"
                               name="pop_line_item_05" placeholder="Ativo" aria-label="Ativo"
                               aria-describedby="line_item_03"/>
                        <label class="form-check-label" for="pop_line_item_05">Ativo</label>
                    </div>
                </div>
            </div>
            <div class="col-sm-12">
                <button type="submit" class="btn btn-primary data-submit me-sm-4 me-1">Adicionar</button>
                <button type="reset" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancelar</button>
            </div>
        </form>

    </div>
</div>

<!-- The Modal Zoom -->
<div id="myModal" class="img-zoom-modal">
    <span id="caption"></span>
    <img class="img-zoom-content" id="img01">
</div>

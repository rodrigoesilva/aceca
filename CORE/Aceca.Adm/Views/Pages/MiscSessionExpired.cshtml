@{
  Layout = "_BlankLayout";
    ViewData["Title"] = "Session Expired - Pages";
}

@section PageStyles {
  <link rel="stylesheet" href="~/vendor/css/pages/page-misc.css">
}

@* ************** Content ************** *@
<!-- Session Expired -->
<div class="misc-wrapper">
  <h1 class="mb-2 mx-2" style="font-size: 6rem;line-height: 6rem">401</h1>
  <h4 class="mb-2">Sua sessão expirou! 🔐</h4>
  <p class="mb-10 mx-2">Você precisa realizar seu login novamente. Volte para a página inicial!</p>
  <div class="d-flex justify-content-center mt-5">
    <img src="~/img/illustrations/tree-3.png" alt="misc-tree" class="img-fluid misc-object d-none d-lg-inline-block">
    <img src="~/img/illustrations/tree.png" alt="misc-tree" class="img-fluid misc-object-right d-none d-lg-inline-block">
    <img src="~/img/illustrations/misc-mask-light.png" alt="misc-error" class="scaleX-n1-rtl misc-bg d-none d-lg-inline-block" height="172" data-app-light-img="illustrations/misc-mask-light.png" data-app-dark-img="illustrations/misc-mask-dark.png">
    <div class="d-flex flex-column align-items-center">
      <img src="~/img/illustrations/misc-under-maintenance.png" alt="misc-error" class="misc-model img-fluid z-1" width="780">
      <div>
        <a href="/Auth/Index" class="btn btn-primary text-center my-6">Fazer login novamente</a>
      </div>
    </div>
  </div>
</div>
<!-- /Session Expired -->

@section PageScripts {
  <script>
    // Limpa qualquer resíduo da sessão expirada no navegador.
    (function () {
      try {
        sessionStorage.removeItem('aceca_sessao');
        document.cookie = 'aceca_cookie=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/;';
      } catch (e) { /* ignore */ }
    })();
  </script>
}

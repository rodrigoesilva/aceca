                <button id="btn-passados" class="tab-btn" onclick="filterEvents('past',this)">Passados</button>
                <button id="btn-todos" class="tab-btn" onclick="filterEvents('all',this)">Todos</button>
            </div>
            <div class="events-grid" id="eventsGrid">
                @foreach (var evento in Model)
                {
                    <div class="event-card" data-type="@evento.Tipo">
                        <div class="event-img" style="background:linear-gradient(135deg,@evento.CorGradienteInicio,@evento.CorGradienteFim)@(evento.GrayscaleFundo ? ";filter:grayscale(30%)" : "")">
                            <span><img src="@evento.ImagemUrl" width="@evento.ImagemLargura" height="@evento.ImagemAltura" loading="lazy" decoding="async" class="autoimage" title="ACECA" alt="ACECA"></span>
                            <span class="event-badge @evento.BadgeClasse">@evento.BadgeTexto</span>
                        </div>
                        <div class="event-info">
                            <div class="event-date">@evento.Data</div>
                            <h3>@evento.Titulo</h3>
                            <p>@evento.Descricao</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
 
